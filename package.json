{
  "name": "@holtbosse/purplepanda",
  "version": "1.0.0",
  "description": "cms",
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./puck": {
      "types": "./dist/puck/index.d.ts",
      "default": "./dist/puck/index.js"
    },
    "./puck/prefab": {
      "types": "./dist/puck/prefab/index.d.ts",
      "default": "./dist/puck/prefab/index.js"
    },
    "./puck/media": {
      "types": "./dist/puck/media/index.d.ts",
      "default": "./dist/puck/media/index.js"
    },
    "./puck/form-fields": {
      "types": "./dist/puck/form-fields/index.d.ts",
      "default": "./dist/puck/form-fields/index.js"
    },
    "./puck/form": {
      "types": "./dist/puck/form/index.d.ts",
      "default": "./src/puck/form/index.js"
    },
    "./pages/*": "./src/pages/*",
    "./middleware": "./src/middleware/index.ts",
    "./schema": {
      "types": "./dist/db/schema.d.ts",
      "default": "./dist/db/schema.js"
    },
    "./form/*": "./src/form/*"
  },
  "scripts": {
    "test": "vitest",
    "build": "tsc",
    "dev": "tsc -w"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.0.1",
    "@types/pg": "^8.20.0",
    "astro": "^7.0.3",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.0",
    "@dnd-kit/dom": "0.4.0",
    "@lucide/astro": "^1.22.0",
    "@puckeditor/core": "^0.22.0",
    "@tailwindcss/vite": "^4.2.4",
    "@tiptap/extension-subscript": "^3.27.1",
    "@tiptap/extension-superscript": "^3.27.1",
    "@tiptap/extensions": "^3.27.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "daisyui": "^5.5.19",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.23.0",
    "pg": "^8.20.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.2.4",
    "zod": "^4.4.3"
  }
}
