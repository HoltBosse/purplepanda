---
// Renders the given UTC date formatted in the visitor's local timezone.
//
// The server doesn't know the visitor's timezone, so it can't pre-format the date without risking
// showing the wrong time. Instead it emits a skeleton placeholder holding the raw UTC timestamp and
// the desired Intl.DateTimeFormat options as data attributes, and a client script swaps in the
// locally-formatted text once it runs in the browser.
interface Props {
    date: Date | string;
    format?: Intl.DateTimeFormatOptions;
    class?: string;
}

const defaultFormat: Intl.DateTimeFormatOptions = {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
};

const { date, format = defaultFormat, class: className } = Astro.props;
const utc = (date instanceof Date ? date : new Date(date)).toISOString();
---
<span
    class:list={['skeleton h-4 w-34 inline-block', className]}
    data-local-datetime
    data-utc={utc}
    data-format={JSON.stringify(format)}
></span>
<script>
    document.querySelectorAll<HTMLElement>('[data-local-datetime]').forEach(el => {
        const { utc, format } = el.dataset;
        if (!utc || !format) return;
        el.textContent = new Date(utc).toLocaleString('en-US', JSON.parse(format));
        el.classList.remove('skeleton', 'h-4', 'w-34', 'inline-block');
    });
</script>
