---
interface Props {
    currentPage: number;
    totalPages: number;
    basePath: string;
}

const { currentPage, totalPages, basePath } = Astro.props;
//console.log("Pagination props: ", { currentPage, totalPages, basePath });
---
<div class="join">
    <a href={`${basePath}?page=1`} class="bg-base-100 join-item btn">«</a>
    {currentPage - 2 > 0 && <a href={`${basePath}?page=${currentPage - 2}`} class="bg-base-100 join-item btn">{currentPage - 2}</a>}
    {currentPage -1 > 0 && <a href={`${basePath}?page=${currentPage - 1}`} class="bg-base-100 join-item btn">{currentPage - 1}</a>}
    <a class="bg-info text-white join-item btn btn-active">{currentPage}</a>
    {currentPage + 1 <= totalPages && <a href={`${basePath}?page=${currentPage + 1}`} class="bg-base-100 join-item btn">{currentPage + 1}</a>}
    {currentPage + 2 <= totalPages && <a href={`${basePath}?page=${currentPage + 2}`} class="bg-base-100 join-item btn">{currentPage + 2}</a>}
    <a href={`${basePath}?page=${totalPages}`} class="bg-base-100 join-item btn">»</a>
</div>