---
import '../styles/global.css';
import externalPuckConfig from "virtual:purplepanda/puck-config";
import type { AstroComponent } from '@lucide/astro';
import { ClipboardList, FileText, House, Images, LayoutTemplate, LogOut, PenLine, Settings, Users } from '@lucide/astro';
import { eq } from 'drizzle-orm';
import * as z from 'zod';
import { AlertList } from '../alert/AlertList.js';
import Container from '../components/Container.astro';
import { getDb } from '../db/db.js';
import { users } from '../db/schema.js';
import { runOverride } from '../hooks/index.js';

const db = getDb();

const userId = await Astro.session?.get('userId');
const [user] = await db.select().from(users).where(eq(users.id, userId)).limit(1);

if(!user) {
	throw new Error('User not found');
}

const alerts = Astro.locals.alerts ?? [];

const contentTypes = (externalPuckConfig ? externalPuckConfig.contentTypes : []) ?? [];

const theme = user.theme !== 'system' ? user.theme : undefined;

interface NavSubItem {
	label: string;
	href: string;
}

interface NavItem {
	// Stable key. Drives the drawer panel's DOM id (`panel-${id}`) and the nav button's
	// `data-panel` attribute for items with subItems; otherwise just an identifier a plugin can
	// match on.
	id: string;
	label: string;
	icon: AstroComponent;
	// A plain link (e.g. Home) has `href` and no `subItems`. A drawer item (e.g. Users) has
	// `subItems` and no `href` -- clicking it toggles its panel instead of navigating.
	href?: string;
	subItems?: NavSubItem[];
}

const navSubItemSchema = z.object({
	label: z.string(),
	href: z.string(),
});

const navItemSchema = z.object({
	id: z.string(),
	label: z.string(),
	icon: z.custom<AstroComponent>((val) => typeof val === 'function', { message: 'icon must be a component' }),
	href: z.string().optional(),
	subItems: z.array(navSubItemSchema).optional(),
});

const navItemsSchema = z.array(navItemSchema);

const defaultNavItems: NavItem[] = [
	{ id: 'home', label: 'Home', icon: House, href: '/admin' },
	{
		id: 'users',
		label: 'Users',
		icon: Users,
		subItems: [
			{ label: 'All Users', href: '/admin/users' },
			{ label: 'Add User', href: '/admin/users/new' },
			{ label: 'Roles & Permissions', href: '/admin/users/roles' },
		],
	},
	{
		id: 'templates',
		label: 'Templates',
		icon: LayoutTemplate,
		subItems: [
			{ label: 'All Templates', href: '/admin/templates' },
			{ label: 'New Template', href: '/admin/templates/new' },
		],
	},
	{
		id: 'pages',
		label: 'Pages',
		icon: FileText,
		subItems: [
			{ label: 'All Pages', href: '/admin/pages' },
			{ label: 'New Page', href: '/admin/pages/new' },
		],
	},
	{
		id: 'content',
		label: 'Content',
		icon: PenLine,
		subItems: contentTypes.map((ct) => ({ label: ct.title, href: `/admin/content/${ct.id}` })),
	},
	{
		id: 'forms',
		label: 'Forms',
		icon: ClipboardList,
		subItems: [
			{ label: 'All Forms', href: '/admin/forms' },
			{ label: 'New Form', href: '/admin/forms/new' },
			{ label: 'Submissions', href: '/admin/forms/submissions' },
		],
	},
	{
		id: 'media',
		label: 'Media',
		icon: Images,
		subItems: [
			{ label: 'Images', href: '/admin/media' },
			{ label: 'Documents', href: '/admin/documents' },
		],
	},
	{
		id: 'settings',
		label: 'Settings',
		icon: Settings,
		subItems: [
			{ label: 'Configurations', href: '/admin/settings' },
			{ label: 'Redirects', href: '/admin/redirects' },
			{ label: 'Tags', href: '/admin/tags' },
			{ label: 'Audit', href: '/admin/audit' },
		],
	},
];

// Plugins can reorder, relabel, re-icon, add, or remove nav items/subitems by returning a modified
// copy of `defaultNavItems` (or an entirely custom array) -- see the admin:nav hook in the docs.
const navItems = (await runOverride('admin:nav', { user, defaultNavItems }, navItemsSchema)) ?? defaultNavItems;
---
<!DOCTYPE html>
<html lang="en" data-theme={theme}>
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
	<meta http-equiv="X-UA-Compatible" content="ie=edge">
	<link rel="icon" type="image/svg+xml" href="/admin/assets/favicon.svg" />
	<link rel="icon" href="/admin/assets/favicon.ico" />
</head>
<body class="h-screen overflow-hidden">
	<div class="flex h-full">

		<!-- Vertical Icon Nav -->
		<nav class="flex flex-col w-16 bg-base-100 border-r border-base-300 items-center py-3 gap-1 shrink-0 z-50">

			{navItems.map(({ id, label, icon: Icon, href, subItems }) => (
				subItems ? (
					<button data-panel={id} class="nav-drawer-btn flex flex-col items-center justify-center gap-1 w-full py-3 px-1 rounded-lg hover:bg-base-300 transition-colors text-base-content cursor-pointer">
						<Icon size={20} />
						<span class="text-[10px] font-medium leading-tight">{label}</span>
					</button>
				) : (
					<a href={href} class="flex flex-col items-center justify-center gap-1 w-full py-3 px-1 rounded-lg hover:bg-base-300 transition-colors text-base-content">
						<Icon size={20} />
						<span class="text-[10px] font-medium leading-tight">{label}</span>
					</a>
				)
			))}

			<!-- User Avatar -->
			<div class="mt-auto dropdown dropdown-right dropdown-end">
				<button tabindex="0" role="button" class="flex flex-col items-center justify-center w-full py-3 px-1 rounded-lg hover:bg-base-300 transition-colors">
					<div class="avatar avatar-placeholder">
						<div class="bg-primary text-primary-content rounded-full w-9">
							<span class="text-xs font-semibold">{user.fname[0]?.toUpperCase()}{user.lname[0]?.toUpperCase()}</span>
						</div>
					</div>
				</button>
				<ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-[100] w-44 p-2 shadow-lg border border-base-300">
					<li><a href="/admin/profile">Profile</a></li>
					<li>
						<!-- A plain button (not a form) so this stays the direct child of <li> that
						daisyUI's menu styling (grid layout, padding, hover state) targets — exactly like
						the <a> it replaced. The POST itself is fired from the script below. -->
						<button type="button" id="logout-button" class="text-error flex items-center justify-between">
							Logout
							<LogOut size={15} />
						</button>
					</li>
				</ul>
			</div>

		</nav>

		<!-- Drawer + Main Content -->
		<div class="drawer flex-1">
			<input id="drawer-toggle" type="checkbox" class="drawer-toggle" />

			<div class="drawer-content h-full overflow-auto bg-base-200">
				<main class="p-6 h-full bg-base-200">
					<Container>
						<AlertList alerts={alerts} />
						<slot />
					</Container>
				</main>
			</div>

			<div class="drawer-side start-16">
				<label for="drawer-toggle" aria-label="close sidebar" class="drawer-overlay"></label>
				<aside class="bg-base-200 min-h-full w-60 border-r border-base-300">

					{navItems.filter((item) => item.subItems).map((item) => (
						<div id={`panel-${item.id}`} class="drawer-panel hidden">
							<h2 class="text-sm font-semibold uppercase tracking-wider text-base-content/60 px-5 pt-4 pb-2">{item.label}</h2>
							<ul class="menu w-full px-2 py-1 gap-0.5">
								{item.subItems?.map((sub) => (
									<li><a href={sub.href}>{sub.label}</a></li>
								))}
							</ul>
						</div>
					))}
				</aside>
			</div>
		</div>

	</div>

	<script>
		const toggle = document.getElementById('drawer-toggle') as HTMLInputElement;
		const navBtns = document.querySelectorAll<HTMLButtonElement>('.nav-drawer-btn');
		let activePanel: string | null = null;

		navBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				const panelId = btn.dataset.panel!;

				if (activePanel === panelId && toggle.checked) {
					// Same item clicked while open → close drawer
					toggle.checked = false;
					activePanel = null;
					navBtns.forEach(b => b.classList.remove('bg-base-300', 'text-primary'));
				} else {
					// Open drawer and switch to this panel
					document.querySelectorAll('.drawer-panel').forEach(p => p.classList.add('hidden'));
					document.getElementById('panel-' + panelId)?.classList.remove('hidden');
					navBtns.forEach(b => b.classList.remove('bg-base-300', 'text-primary'));
					btn.classList.add('bg-base-300', 'text-primary');
					toggle.checked = true;
					activePanel = panelId;
				}
			});
		});

		// Reset active state when drawer is closed via overlay
		toggle.addEventListener('change', () => {
			if (!toggle.checked) {
				activePanel = null;
				document.querySelectorAll('.drawer-panel').forEach(p => p.classList.add('hidden'));
				navBtns.forEach(b => b.classList.remove('bg-base-300', 'text-primary'));
			}
		});

		// /admin/logout is POST-only (a GET would be a state-changing request outside Astro's
		// Origin-check coverage), so this fires the request via fetch rather than a plain link.
		document.getElementById('logout-button')?.addEventListener('click', async () => {
			try {
				await fetch('/admin/logout', { method: 'POST' });
			} finally {
				window.location.href = '/admin/login';
			}
		});
	</script>
</body>
</html>
