---
import type { ComponentProps } from "astro/types";
import BaseField from "../BaseField.astro";

interface Props extends ComponentProps<typeof BaseField> {
  placeholder?: string;
  classList?: string;
  optionsClassList?: string;
  options: { value: string; label: string }[];
  multiple?: boolean;
}

const { placeholder, classList, optionsClassList, options, multiple, ...baseProps } = Astro.props;
const { id, name, value, required } = baseProps;
const selectedValues = multiple ? (Array.isArray(value) ? value : value !== undefined ? [value] : []) : undefined;
---

<BaseField {...baseProps}>
    <select
        class={classList}
        name={name}
        id={id}
        required={required}
        multiple={multiple}
    >
        {placeholder && !multiple && <option class={optionsClassList} value="" disabled selected={value === undefined && !options.some(option => option.value === value)}>{placeholder}</option>}
        {options.map((option) => (
            <option class={optionsClassList} value={option.value} selected={multiple ? selectedValues!.includes(option.value) : option.value === value}>
                {option.label}
            </option>
        ))}
    </select>
</BaseField>