---
import BaseField from "../BaseField.astro";
import type { BaseFieldProps } from "../types";
import { DEFAULT_SAMPLE_TEXT, presetFonts } from "./font-picker-core";
import { extractFamilyFromLink } from "./font-utils";

interface Props extends BaseFieldProps {
  placeholder?: string;
  sampleText?: string;
  fontFamilies?: string[];
}

const { placeholder, sampleText, fontFamilies, ...baseProps } = Astro.props as Props;
const { id, name, value } = baseProps;
const currentFamily = extractFamilyFromLink(value);
const buttonLabel = currentFamily ?? placeholder ?? "Select a font";
const sample = sampleText ?? DEFAULT_SAMPLE_TEXT;
const dialogId = `${id}-dialog`;
const presets = presetFonts(fontFamilies ?? []);
---

<BaseField {...baseProps}>
  <div class="flex items-center gap-3" data-font-picker data-field-id={id}>
    <input type="hidden" name={name} id={id} value={value ?? ""} data-font-picker-input />
    <button
      type="button"
      class="btn btn-outline justify-start flex-1 h-auto py-2 px-3"
      data-font-picker-trigger
    >
      <span class="flex flex-col items-start gap-0.5 overflow-hidden">
        <span class="text-xs text-base-content/50" data-font-picker-label>{buttonLabel}</span>
        <span
          class="text-base truncate"
          data-font-picker-sample
          style={currentFamily ? `font-family: '${currentFamily}';` : ""}
        >
          {sample}
        </span>
      </span>
    </button>
    {currentFamily && <link rel="stylesheet" href={value} data-font-picker-preview-link />}
  </div>
</BaseField>

<dialog
  id={dialogId}
  closedby="any"
  data-font-picker-dialog
  data-sample-text={sample}
  data-presets={JSON.stringify(presets)}
  class="relative m-auto w-[calc(100vw-2rem)] max-w-[calc(100vw-2rem)] md:max-w-2xl rounded-xl bg-base-100 p-6 shadow-xl backdrop:bg-black/50 backdrop:backdrop-blur-sm"
>
  <button type="button" class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" data-font-picker-close>✕</button>
  <h3 class="text-lg font-semibold mb-4">Select a font</h3>
  <input
    type="text"
    placeholder="Search fonts..."
    class="input input-bordered w-full mb-4"
    data-font-picker-search
    autocomplete="off"
  />
  <div class="max-h-96 overflow-y-auto space-y-1 pr-1" data-font-picker-list>
    <p class="text-sm text-base-content/50 p-4">Loading fonts…</p>
  </div>
</dialog>

<script>
  import {
    DEFAULT_SAMPLE_TEXT,
    ensureStylesheet,
    type Font,
    type FontEntry,
    fontEntries,
    loadFontList,
    MAX_VISIBLE_ROWS,
    matchesQuery,
    observeRows,
    type PresetFont,
    showRowPreview,
  } from "./font-picker-core";
  import { extractFamilyFromLink } from "./font-utils";

  document.querySelectorAll<HTMLElement>("[data-font-picker]").forEach((wrapper) => {
    if (wrapper.dataset.fontPickerInitialized) return;
    wrapper.dataset.fontPickerInitialized = "true";

    const fieldId = wrapper.dataset.fieldId!;
    const hiddenInput = wrapper.querySelector<HTMLInputElement>("[data-font-picker-input]");
    const trigger = wrapper.querySelector<HTMLButtonElement>("[data-font-picker-trigger]");
    const label = wrapper.querySelector<HTMLElement>("[data-font-picker-label]");
    const sampleEl = wrapper.querySelector<HTMLElement>("[data-font-picker-sample]");
    const dialog = document.getElementById(`${fieldId}-dialog`) as HTMLDialogElement | null;
    if (!hiddenInput || !trigger || !label || !sampleEl || !dialog) return;

    const searchInput = dialog.querySelector<HTMLInputElement>("[data-font-picker-search]")!;
    const list = dialog.querySelector<HTMLElement>("[data-font-picker-list]")!;
    const closeButton = dialog.querySelector<HTMLButtonElement>("[data-font-picker-close]");
    const sampleText = dialog.dataset.sampleText ?? DEFAULT_SAMPLE_TEXT;
    const presets: PresetFont[] = JSON.parse(dialog.dataset.presets || "[]");

    closeButton?.addEventListener("click", () => dialog.close());

    let observer: IntersectionObserver | null = null;
    let allFonts: Font[] = [];
    let rendered = false;

    function selectEntry(entry: FontEntry) {
      hiddenInput!.value = entry.href;
      label!.textContent = entry.family;
      sampleEl!.style.fontFamily = `'${entry.family}'`;
      ensureStylesheet(entry.href);
      dialog!.close();
    }

    function renderList(query: string) {
      list.innerHTML = "";
      const currentFamily = extractFamilyFromLink(hiddenInput!.value);
      const matches = fontEntries(presets, allFonts).filter((e) => matchesQuery(e.family, query));

      if (matches.length === 0) {
        const empty = document.createElement("p");
        empty.className = "text-sm text-base-content/50 p-4";
        empty.textContent = allFonts.length === 0 && presets.length === 0 ? "Loading fonts…" : "No fonts match your search.";
        list.appendChild(empty);
        return;
      }

      observer?.disconnect();
      observer = observeRows(list, showRowPreview);

      const visible = matches.slice(0, MAX_VISIBLE_ROWS);
      for (const entry of visible) {
        const row = document.createElement("button");
        row.type = "button";
        row.dataset.href = entry.href;
        row.dataset.family = entry.family;
        row.className =
          "w-full text-left px-4 py-3 rounded-lg hover:bg-base-200 flex flex-col gap-1 border " +
          (entry.family === currentFamily ? "border-primary bg-base-200" : "border-transparent");

        const meta = document.createElement("span");
        meta.className = "text-xs text-base-content/50";
        meta.textContent = entry.isPreset ? `${entry.family} · Site font` : `${entry.family} · ${entry.category}`;

        const rowSample = document.createElement("span");
        rowSample.className = "text-lg truncate";
        rowSample.dataset.rowSample = "true";
        rowSample.textContent = sampleText;

        row.append(meta, rowSample);
        row.addEventListener("click", () => selectEntry(entry));
        list.appendChild(row);
        observer.observe(row);
      }

      if (matches.length > visible.length) {
        const note = document.createElement("p");
        note.className = "text-xs text-base-content/40 p-2 text-center";
        note.textContent = `Showing ${visible.length} of ${matches.length} matching fonts. Refine your search to narrow results.`;
        list.appendChild(note);
      }
    }

    let debounceTimer: ReturnType<typeof setTimeout>;
    searchInput.addEventListener("input", () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => renderList(searchInput.value), 150);
    });

    trigger.addEventListener("click", async () => {
      dialog.showModal();
      renderList(searchInput.value);
      if (rendered) return;
      try {
        allFonts = await loadFontList();
        rendered = true;
        renderList(searchInput.value);
      } catch {
        if (presets.length === 0) {
          list.innerHTML = "";
          const error = document.createElement("p");
          error.className = "text-sm text-error p-4";
          error.textContent = "Failed to load fonts. Please try again.";
          list.appendChild(error);
        }
      }
    });
  });
</script>
