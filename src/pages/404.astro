---
import type { Data } from '@puckeditor/core';
import CustomNotFound from '../components/CustomNotFound.astro';
import DefaultNotFound from '../components/DefaultNotFound.astro';
import { getSetting } from '../db/content-cache.js';
import { getDb } from '../db/db.js';
import { resolveFontSettings } from '../db/fonts.js';
import { NOT_FOUND_SETTING_KEY } from '../db/not-found.js';
import { formatPageTitle, resolveSiteName } from '../db/site.js';
import { resolveDataForSSR } from '../puck/server-data-wrapper.js';
import externalPuckConfig from '../puck.config.js';

Astro.response.status = 404;

const db = getDb();
const config = externalPuckConfig ?? {};

// The custom 404 page is edited under /admin/settings/not-found. Until one is saved, the built-in
// page in DefaultNotFound.astro is rendered instead. It's standalone: never wrapped in a template.
const notFoundContent = await getSetting(db, NOT_FOUND_SETTING_KEY) as Data | undefined;

const custom = notFoundContent
    ? await (async () => {
        const [pageData, fontSettings, siteName] = await Promise.all([
            resolveDataForSSR(config, notFoundContent, Astro.locals),
            resolveFontSettings(db),
            resolveSiteName(db),
        ]);

        const rawTitle: string = (pageData as any)?.root?.props?.title || 'Page Not Found';
        return { pageData, title: formatPageTitle(rawTitle, siteName), fontSettings };
    })()
    : undefined;
---

{custom ? <CustomNotFound {...custom} /> : <DefaultNotFound />}
