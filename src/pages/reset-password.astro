---
import '../styles/global.css';
import { parseLoginTarget, withLoginTarget } from '../auth/login-target.js';
import { isPasswordResetTokenLive, resetPasswordErrorSchema, resetTokenSchema } from '../auth/password-reset.js';

// Where a reset email's link lands (see forgot-password-action.ts): asks for the new password and
// posts it, with the token, to reset-password-action.ts. Root site only. The token is only checked
// here, not used up, so a link that's expired (or already used) says so before anyone types a
// password.
if (!Astro.locals.tenant.isRoot) {
  return Astro.rewrite('/404');
}

const target = parseLoginTarget(Astro.url.searchParams);
const token = resetTokenSchema.safeParse(Astro.url.searchParams.get("token"));
const live = token.success && (await isPasswordResetTokenLive(token.data));
const error = resetPasswordErrorSchema.safeParse(Astro.url.searchParams.get("error")).data;
const forgotHref = withLoginTarget('/forgot-password', target);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- The token is in this page's URL: never send it on in a Referer. Not no-referrer, which also
         makes the form's POST carry `Origin: null`, and Astro refuses that as cross-site. -->
    <meta name="referrer" content="strict-origin" />
    <title>Reset password</title>
    <link rel="icon" type="image/svg+xml" href="/admin/assets/favicon.svg" />
    <link rel="icon" href="/admin/assets/favicon.ico" />
  </head>
  <body class="min-h-screen flex items-center justify-center bg-base-200">
    <div class="card bg-base-100 shadow-md w-full" style="max-width: 24rem;">
      <div class="card-body">
        <h1 class="card-title text-2xl mb-2">Reset password</h1>
        {live && token.success ? (
          <>
            {error === "mismatch" && (
              <p class="text-error text-sm mb-2">The passwords didn't match. Please try again.</p>
            )}
            {error === "length" && (
              <p class="text-error text-sm mb-2">Passwords must be between 8 and 1024 characters.</p>
            )}
            {error === "busy" && (
              <p class="text-error text-sm mb-2">The server is busy. Please try again in a moment.</p>
            )}
            <form method="POST" action="/reset-password-action" class="flex flex-col gap-4">
              <input type="hidden" name="token" value={token.data} />
              {target.site && <input type="hidden" name="site" value={target.site} />}
              {target.host && <input type="hidden" name="host" value={target.host} />}
              <label class="form-control w-full">
                <div class="label">
                  <span class="label-text font-medium">New password</span>
                </div>
                <input
                  type="password"
                  name="password"
                  required
                  minlength="8"
                  maxlength="1024"
                  autocomplete="new-password"
                  class="input input-bordered w-full"
                />
              </label>
              <label class="form-control w-full">
                <div class="label">
                  <span class="label-text font-medium">Confirm new password</span>
                </div>
                <input
                  type="password"
                  name="confirmPassword"
                  required
                  minlength="8"
                  maxlength="1024"
                  autocomplete="new-password"
                  class="input input-bordered w-full"
                />
              </label>
              <button type="submit" class="btn btn-primary w-full">Reset password</button>
            </form>
          </>
        ) : (
          <>
            <p class="text-error text-sm mb-2">This reset link has expired or has already been used.</p>
            <a href={forgotHref} class="btn btn-primary w-full">Request a new link</a>
          </>
        )}
      </div>
    </div>
  </body>
</html>
