---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createHash } from 'node:crypto';
import { getDb } from '../../../db/db.js';
import { users, roles, userRoles } from '../../../db/schema.js';
import { CircleCheck, CircleX } from '@lucide/astro';
import { capitalize } from '../../../string';
import { desc, eq, gt } from 'drizzle-orm';

const db = getDb();
const allUsers = await db.select().from(users).where(gt(users.state, -1)).orderBy(desc(users.id));

const userRoleRows = await db
    .select({ userId: userRoles.userId, title: roles.title })
    .from(userRoles)
    .innerJoin(roles, eq(userRoles.roleId, roles.id));

const rolesByUser = new Map<string, string[]>();
for (const row of userRoleRows) {
    if (!rolesByUser.has(row.userId)) rolesByUser.set(row.userId, []);
    rolesByUser.get(row.userId)!.push(row.title);
}
---

<AdminLayout>
    <div class="flex items-center justify-between align-middle border-b border-base-300 pt-2 pb-4">
        <h1 class="text-2xl font-semibold">Users</h1>
        <a href="/admin/users/new" class="btn btn-primary">New</a>
    </div>
    <form id="bulk-form" method="POST"></form>
    <table class="table p-2 bg-base-100 rounded-lg">
        <thead>
            <tr class="hidden [table:has(.row-select:checked)_&]:table-row">
                <th class="w-px whitespace-nowrap">
                    <label>
                        <input type="checkbox" class="checkbox select-all" />
                    </label>
                </th>
                <th colspan="3">
                    <div class="flex items-center gap-2">
                        <button form="bulk-form" type="submit" formaction="/admin/users/bulk/publish" class="btn btn-xs btn-outline btn-accent">Publish</button>
                        <button form="bulk-form" type="submit" formaction="/admin/users/bulk/unpublish" class="btn btn-xs btn-outline btn-warning">Unpublish</button>
                        <button form="bulk-form" type="submit" formaction="/admin/users/bulk/delete" class="btn btn-xs btn-error">Delete</button>
                    </div>
                </th>
            </tr>
            <tr class="[table:has(.row-select:checked)_&]:hidden">
                <th class="w-px whitespace-nowrap">
                    <label>
                        <input type="checkbox" class="checkbox select-all" />
                    </label>
                </th>
                <th class="w-px whitespace-nowrap">State</th>
                <th>User</th>
                <th>Roles</th>
            </tr>
        </thead>
        <tbody>
            {allUsers.map(user=>(
                <tr>
                    <td>
                        <label>
                            <input
                                form="bulk-form"
                                type="checkbox"
                                class="checkbox row-select"
                                name="selected[]"
                                value={user.id}
                            />
                        </label>
                    </td>
                    <td class="w-px whitespace-nowrap">
                        <form action={`/admin/users/toggle/${user.id}`} method="POST">
                            <button type="submit" class="btn btn-square">
                                {user.state === 1 ? <CircleCheck size={20} class="text-green-500" /> : <CircleX size={20} class="text-red-500" />}
                            </button>
                        </form>
                    </td>
                    <td>
                        <a href={`/admin/users/edit/${user.id}`}>
                            <div class="flex items-center gap-3">
                                <div class="avatar">
                                    <div class="mask mask-squircle h-12 w-12">
                                        <img
                                        src={`https://www.gravatar.com/avatar/${createHash('sha256').update(user.email.trim().toLowerCase()).digest('hex')}?d=identicon&s=64`}
                                        alt="Avatar Tailwind CSS Component" />
                                    </div>
                                </div>
                                <div>
                                    <div class="font-bold link link-info link-hover">{capitalize(user.fname)} {capitalize(user.lname)}</div>
                                    <div class="text-sm opacity-50">{user.email}</div>
                                </div>
                            </div>
                        </a>
                    </td>
                    <td>
                        <div class="flex flex-wrap gap-1">
                            {(rolesByUser.get(user.id) ?? []).map(title => (
                                <span class="badge badge-ghost badge-sm">{title}</span>
                            ))}
                            {(rolesByUser.get(user.id) ?? []).length === 0 && (
                                <span class="text-sm opacity-50">No roles</span>
                            )}
                        </div>
                    </td>
                </tr>
            ))}
        </tbody>
    </table>
    <script>import '../../../scripts/select-all'</script>
</AdminLayout>
