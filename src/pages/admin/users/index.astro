---
import { createHash } from 'node:crypto';
import { CircleCheck, CircleX } from '@lucide/astro';
import { and, desc, eq, gt, sql } from 'drizzle-orm';
import { z } from 'zod';
import Pagination from '../../../components/Pagination.astro';
import { getDb } from '../../../db/db.js';
import { roles, userRoles, users } from '../../../db/schema.js';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { applySearchJoins, buildSearchWhere, type DrizzleSearchConfig } from '../../../search/drizzle.js';
import { parseSearchQuery } from '../../../search/parser.js';
import SearchBar from '../../../search/SearchBar';
import type { SearchFieldSpec } from '../../../search/types.js';
import { capitalize } from '../../../string';

const db = getDb();

// Matches the display name the table renders, so `name:"john reese"` behaves the way it reads.
const fullNameExpr = sql`${users.fname} || ' ' || ${users.lname}`;

// Client-safe field descriptions passed to <SearchBar>: drive its validation, github-style
// valid/invalid highlighting, and the qualifier/value autocomplete dropdown.
// "enabled"/"disabled" rather than published/unpublished: for an account this is about whether it
// can sign in (the middleware gates login on state >= 1). No `deleted` — soft-deleted users are
// hard-filtered out of this listing, so it could never match.
const searchFields: SearchFieldSpec[] = [
    {
        name: 'state',
        type: 'enum',
        enumValues: ['enabled', 'disabled'],
        label: 'State',
        description: 'Account state',
    },
    { name: 'name', type: 'text', label: 'Name', description: 'First/last name contains' },
    { name: 'email', type: 'text', label: 'Email', description: 'Email address' },
    // Nullable so `role:null` finds users with no roles assigned at all.
    { name: 'role', type: 'text', nullable: true, label: 'Role', description: 'Assigned role contains' },
];

const searchConfig: DrizzleSearchConfig = {
    fields: [
        {
            name: 'state',
            type: 'enum',
            enumValues: ['enabled', 'disabled'],
            column: users.state,
            valueMap: { enabled: 1, disabled: 0 },
        },
        { name: 'name', type: 'text', column: fullNameExpr, matchMode: 'contains' },
        { name: 'email', type: 'text', column: users.email, matchMode: 'exact' },
        { name: 'role', type: 'text', nullable: true, column: roles.title, matchMode: 'contains' },
    ],
    // A bare term searches name and email together.
    fulltext: { columns: [users.fname, users.lname, users.email] },
    // Left-joined so users without roles are still listed; this is the one genuinely many-to-many
    // join in the admin (a user can hold several roles), which is why the queries below need
    // DISTINCT — otherwise a two-role user would be listed, and counted, twice.
    joins: [
        { table: userRoles, on: eq(userRoles.userId, users.id), type: 'left' },
        { table: roles, on: eq(userRoles.roleId, roles.id), type: 'left' },
    ],
};

const q = Astro.url.searchParams.get('q') ?? '';
const searchWhere = buildSearchWhere(parseSearchQuery(q), searchConfig);

const itemsPerPage = 12;
const pageData = z.coerce.number().int().positive().default(1).safeParse(Astro.url.searchParams.get("page") ?? 1);
let page = 1;
if (pageData.success) {
    page = pageData.data;
}
const offset = (page - 1) * itemsPerPage;

// state > -1 hides soft-deleted users, on top of whatever the search matched.
const listFilter = and(gt(users.state, -1), searchWhere);

const [allUsers, totalUsers] = await Promise.all([
    applySearchJoins(
        // Explicit columns rather than `select()`: the password hash is never needed to render this
        // listing, and DISTINCT can't be applied to a row containing it meaningfully anyway.
        db
            .selectDistinct({
                id: users.id,
                state: users.state,
                fname: users.fname,
                lname: users.lname,
                email: users.email,
            })
            .from(users)
            .$dynamic(),
        searchConfig.joins,
    )
        .where(listFilter)
        .orderBy(desc(users.id))
        .limit(itemsPerPage)
        .offset(offset),
    applySearchJoins(
        db.select({ count: sql<number>`COUNT(DISTINCT ${users.id})` }).from(users).$dynamic(),
        searchConfig.joins,
    )
        .where(listFilter)
        .then(result => result[0]?.count ?? 0),
]);

const totalPages = Math.ceil(totalUsers / itemsPerPage);

const userRoleRows = await db
    .select({ userId: userRoles.userId, title: roles.title })
    .from(userRoles)
    .innerJoin(roles, eq(userRoles.roleId, roles.id));

const rolesByUser = new Map<string, string[]>();
for (const row of userRoleRows) {
    if (!rolesByUser.has(row.userId)) rolesByUser.set(row.userId, []);
    rolesByUser.get(row.userId)!.push(row.title);
}
---

<AdminLayout>
    <div class="flex flex-wrap items-center justify-between gap-3 align-middle border-b border-base-300 pt-2 sticky top-0 z-10 bg-base-200">
        <h1 class="text-2xl font-semibold">Users</h1>
        <a href="/admin/users/new" class="btn btn-primary">New</a>
    </div>
    <div class="pt-4 pb-6">
        <SearchBar client:load fields={searchFields} defaultValue={q} className="w-full" />
    </div>
    <form id="bulk-form" method="POST"></form>
    {allUsers.length === 0 && (
        <div class="text-center text-base-content/60 py-8 bg-base-100 rounded-lg">
            {q ? 'No users match your search.' : 'No users yet.'}
        </div>
    )}
    {allUsers.length > 0 && (
        <>
    <table class="hidden sm:table p-2 bg-base-100 rounded-lg">
        <thead>
            <tr class="hidden [table:has(.row-select:checked)_&]:table-row">
                <th class="w-px whitespace-nowrap">
                    <label>
                        <input type="checkbox" class="checkbox select-all" />
                    </label>
                </th>
                <th colspan="3">
                    <div class="flex items-center gap-2">
                        <button form="bulk-form" type="submit" formaction="/admin/users/bulk/publish" class="btn btn-xs btn-outline btn-accent">Publish</button>
                        <button form="bulk-form" type="submit" formaction="/admin/users/bulk/unpublish" class="btn btn-xs btn-outline btn-warning">Unpublish</button>
                        <button form="bulk-form" type="submit" formaction="/admin/users/bulk/delete" class="btn btn-xs btn-error">Delete</button>
                    </div>
                </th>
            </tr>
            <tr class="[table:has(.row-select:checked)_&]:hidden">
                <th class="w-px whitespace-nowrap">
                    <label>
                        <input type="checkbox" class="checkbox select-all" />
                    </label>
                </th>
                <th class="w-px whitespace-nowrap">State</th>
                <th>User</th>
                <th>Roles</th>
            </tr>
        </thead>
        <tbody>
            {allUsers.map(user=>(
                <tr>
                    <td>
                        <label>
                            <input
                                form="bulk-form"
                                type="checkbox"
                                class="checkbox row-select"
                                name="selected[]"
                                value={user.id}
                            />
                        </label>
                    </td>
                    <td class="w-px whitespace-nowrap">
                        <form action={`/admin/users/toggle/${user.id}`} method="POST">
                            <button type="submit" class="btn btn-square">
                                {user.state === 1 ? <CircleCheck size={20} class="text-green-500" /> : <CircleX size={20} class="text-red-500" />}
                            </button>
                        </form>
                    </td>
                    <td>
                        <a href={`/admin/users/edit/${user.id}`}>
                            <div class="flex items-center gap-3">
                                <div class="avatar">
                                    <div class="mask mask-squircle h-12 w-12">
                                        <img
                                        src={`https://www.gravatar.com/avatar/${createHash('sha256').update(user.email.trim().toLowerCase()).digest('hex')}?d=identicon&s=64`}
                                        alt="Avatar Tailwind CSS Component" />
                                    </div>
                                </div>
                                <div>
                                    <div class="font-bold link link-info link-hover">{capitalize(user.fname)} {capitalize(user.lname)}</div>
                                    <div class="text-sm opacity-50">{user.email}</div>
                                </div>
                            </div>
                        </a>
                    </td>
                    <td>
                        <div class="flex flex-wrap gap-1">
                            {(rolesByUser.get(user.id) ?? []).map(title => (
                                <span class="badge badge-ghost badge-sm">{title}</span>
                            ))}
                            {(rolesByUser.get(user.id) ?? []).length === 0 && (
                                <span class="text-sm opacity-50">No roles</span>
                            )}
                        </div>
                    </td>
                </tr>
            ))}
        </tbody>
    </table>

    <div class="sm:hidden admin-cards flex flex-col gap-3">
        <div class="hidden items-center gap-2 bg-base-100 rounded-lg p-3 [.admin-cards:has(.row-select:checked)_&]:flex">
            <label>
                <input type="checkbox" class="checkbox select-all" />
            </label>
            <button form="bulk-form" type="submit" formaction="/admin/users/bulk/publish" class="btn btn-xs btn-outline btn-accent">Publish</button>
            <button form="bulk-form" type="submit" formaction="/admin/users/bulk/unpublish" class="btn btn-xs btn-outline btn-warning">Unpublish</button>
            <button form="bulk-form" type="submit" formaction="/admin/users/bulk/delete" class="btn btn-xs btn-error">Delete</button>
        </div>
        <div class="flex items-center gap-2 bg-base-100 rounded-lg p-3 [.admin-cards:has(.row-select:checked)_&]:hidden">
            <label class="flex items-center gap-2">
                <input type="checkbox" class="checkbox select-all" />
                <span class="text-sm text-base-content/60">Select all</span>
            </label>
        </div>
        {allUsers.map(user=>(
            <div class="card bg-base-100 rounded-lg p-4">
                <div class="flex items-center justify-between gap-2 pb-3 mb-3 border-b border-base-300">
                    <label class="flex items-center gap-2">
                        <input
                            form="bulk-form"
                            type="checkbox"
                            class="checkbox row-select"
                            name="selected[]"
                            value={user.id}
                        />
                        <span class="text-sm text-base-content/60">Select</span>
                    </label>
                    <form action={`/admin/users/toggle/${user.id}`} method="POST">
                        <button type="submit" class="btn btn-square btn-sm">
                            {user.state === 1 ? <CircleCheck size={18} class="text-green-500" /> : <CircleX size={18} class="text-red-500" />}
                        </button>
                    </form>
                </div>
                <a href={`/admin/users/edit/${user.id}`}>
                    <div class="flex items-center gap-3 pb-3 mb-3 border-b border-base-300">
                        <div class="avatar">
                            <div class="mask mask-squircle h-12 w-12">
                                <img
                                src={`https://www.gravatar.com/avatar/${createHash('sha256').update(user.email.trim().toLowerCase()).digest('hex')}?d=identicon&s=64`}
                                alt="Avatar Tailwind CSS Component" />
                            </div>
                        </div>
                        <div>
                            <div class="font-bold link link-info link-hover">{capitalize(user.fname)} {capitalize(user.lname)}</div>
                            <div class="text-sm opacity-50">{user.email}</div>
                        </div>
                    </div>
                </a>
                <dl class="flex flex-col gap-2">
                    <div class="flex justify-between gap-4">
                        <dt class="text-sm text-base-content/60">Roles</dt>
                        <dd class="text-right">
                            <div class="flex flex-wrap gap-1 justify-end">
                                {(rolesByUser.get(user.id) ?? []).map(title => (
                                    <span class="badge badge-ghost badge-sm">{title}</span>
                                ))}
                                {(rolesByUser.get(user.id) ?? []).length === 0 && (
                                    <span class="text-sm opacity-50">No roles</span>
                                )}
                            </div>
                        </dd>
                    </div>
                </dl>
            </div>
        ))}
    </div>
        </>
    )}
    {totalUsers - allUsers.length > 0 &&
        <div class="pt-6 pb-6 flex items-center justify-center">
            <Pagination currentPage={page} totalPages={totalPages} basePath="/admin/users/" params={{ q }} />
        </div>
    }
    <script>import '../../../scripts/select-all'</script>
</AdminLayout>
