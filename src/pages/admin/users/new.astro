---
import { and, eq, type InferSelectModel } from 'drizzle-orm';
import { canManageAccount, isMemberOfCurrentTenant } from '../../../auth/accounts.js';
import { getSessionUser } from '../../../auth/index.js';
import { getDb } from '../../../db/db.js';
import { roles, userRoles, users } from '../../../db/schema.js';
import Form from '../../../form/Form.astro';
import { getAllFields } from '../../../form/index.js';
import { createFormFlashSession } from '../../../form/session.js';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getEditUserForm, getInviteForm } from './_form.js';

const db = getDb();

//get [id] from url
const { id } = Astro.params;

const editor = await getSessionUser(Astro.session);
if (!editor) {
	return Astro.redirect('/admin/login');
}

let user: InferSelectModel<typeof users> | undefined;
if(id) {
	// Only this tenant's members are editable here, however the id was arrived at.
	[user] = await db.select().from(users).where(and(eq(users.id, id), isMemberOfCurrentTenant())).limit(1);
	if(!user) {
		return Astro.rewrite('/admin/404');
	}
}

// roles and user_roles are row-level-secured, so these are this tenant's roles only.
const allRoles = await db.select().from(roles);
const roleOptions = allRoles.map(role => ({ value: role.id, label: role.title }));

const selectedRoleIds = id
	? (await db.select({ roleId: userRoles.roleId }).from(userRoles).where(eq(userRoles.userId, id))).map(r => r.roleId)
	: [];

const fields = getAllFields();
const formFlash = createFormFlashSession(Astro.session);
const flash = await formFlash.get('user') ?? {};
await formFlash.delete('user');
const form = user
	? getEditUserForm(user, fields, `/admin/users/update/${user.id}`, flash, roleOptions, selectedRoleIds, {
		identityLocked: !(await canManageAccount(editor, user)),
		resetAction: `/admin/users/send-reset/${user.id}`,
	})
	: getInviteForm(fields, '/admin/users/update', flash, roleOptions);
---

<AdminLayout>
	<Form form={form} fields={fields}>
		<div slot="before-fields" class="flex items-center justify-between align-middle pt-2">
			<h1 class="text-2xl font-semibold">{user ? 'Edit User' : 'Invite User'}</h1>
			<button class="btn btn-primary">{user ? 'Save' : 'Send invite'}</button>
		</div>
	</Form>
</AdminLayout>
