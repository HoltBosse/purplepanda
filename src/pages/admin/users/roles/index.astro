---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getDb } from '../../../../db/db.js';
import { roles } from '../../../../db/schema.js';
import { CircleCheck, CircleX } from '@lucide/astro';
import { desc } from 'drizzle-orm';

const db = getDb();
const allRoles = await db.select().from(roles).orderBy(desc(roles.id));
---

<AdminLayout>
	<div class="flex items-center justify-between align-middle border-b border-base-300 pt-2 pb-4">
        <h1 class="text-2xl font-semibold">Roles</h1>
        <a href="/admin/users/roles/new" class="btn btn-primary">New</a>
    </div>
    <form id="bulk-form" method="POST"></form>
    <table class="table p-2 bg-base-100 rounded-lg">
        <thead>
            <tr class="hidden [table:has(.row-select:checked)_&]:table-row">
                <th class="w-px whitespace-nowrap">
                    <label>
                        <input type="checkbox" class="checkbox select-all" />
                    </label>
                </th>
                <th colspan="3">
                    <div class="flex items-center gap-2">
                        <button form="bulk-form" type="submit" formaction="/admin/users/roles/bulk/publish" class="btn btn-xs btn-outline btn-accent">Enable</button>
                        <button form="bulk-form" type="submit" formaction="/admin/users/roles/bulk/unpublish" class="btn btn-xs btn-outline btn-warning">Disable</button>
                        <button form="bulk-form" type="submit" formaction="/admin/users/roles/bulk/delete" class="btn btn-xs btn-error">Delete</button>
                    </div>
                </th>
            </tr>
            <tr class="[table:has(.row-select:checked)_&]:hidden">
                <th class="w-px whitespace-nowrap">
                    <label>
                        <input type="checkbox" class="checkbox select-all" />
                    </label>
                </th>
                <th class="w-px whitespace-nowrap">State</th>
                <th class="w-1/2">Title</th>
                <th class="w-1/2">Admin Access</th>
            </tr>
        </thead>
        <tbody>
            {allRoles.map(role => (
                <tr>
                    <td>
                        <label>
                            <input
                                form="bulk-form"
                                type="checkbox"
                                class="checkbox row-select"
                                name="selected[]"
                                value={role.id}
                            />
                        </label>
                    </td>
                    <td class="w-px whitespace-nowrap">
                        <form action={`/admin/users/roles/toggle/${role.id}`} method="POST">
                            <button class="btn btn-square" type="submit">
                                {role.state === 1 ? <CircleCheck size={20} class="text-green-500" /> : <CircleX size={20} class="text-red-500" />}
                            </button>
                        </form>
                    </td>
                    <td class="w-1/2">
                        <a href={`/admin/users/roles/edit/${role.id}`}>
                            <span class="font-bold link-info link-hover">{role.title}</span>
                        </a>
                    </td>
                    <td class="w-1/2">
                        {role.adminAccess
                            ? <span class="badge badge-success badge-sm">Yes</span>
                            : <span class="badge badge-ghost badge-sm">No</span>}
                    </td>
                </tr>
            ))}
        </tbody>
    </table>
    <script>import '../../../../scripts/select-all'</script>
</AdminLayout>
