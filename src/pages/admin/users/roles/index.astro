---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getDb } from '../../../../db/db.js';
import { roles } from '../../../../db/schema.js';
import { CircleCheck, CircleX } from '@lucide/astro';
import { desc, sql } from 'drizzle-orm';
import { z } from 'zod';
import Pagination from '../../../../components/Pagination.astro';
import SearchBar from '../../../../search/SearchBar';
import { parseSearchQuery } from '../../../../search/parser.js';
import { buildSearchWhere, type DrizzleSearchConfig } from '../../../../search/drizzle.js';
import type { SearchFieldSpec } from '../../../../search/types.js';

const db = getDb();

// Client-safe field descriptions passed to <SearchBar>: drive its validation, github-style
// valid/invalid highlighting, and the qualifier/value autocomplete dropdown.
// "enabled"/"disabled" matches this page's own Enable/Disable bulk actions. Unlike the users and
// forms listings this one has no base state filter, so soft-deleted roles are genuinely visible
// here and `state:deleted` can actually match.
const searchFields: SearchFieldSpec[] = [
    {
        name: 'state',
        type: 'enum',
        enumValues: ['enabled', 'disabled', 'deleted'],
        label: 'State',
        description: 'Role state',
    },
    { name: 'title', type: 'text', label: 'Title', description: 'Role title contains' },
    { name: 'admin', type: 'boolean', label: 'Admin access', description: 'Grants admin access' },
];

const searchConfig: DrizzleSearchConfig = {
    fields: [
        {
            name: 'state',
            type: 'enum',
            enumValues: ['enabled', 'disabled', 'deleted'],
            column: roles.state,
            valueMap: { enabled: 1, disabled: 0, deleted: -1 },
        },
        { name: 'title', type: 'text', column: roles.title, matchMode: 'contains' },
        { name: 'admin', type: 'boolean', column: roles.adminAccess },
    ],
    // A bare term searches the role title — the only free text this listing shows.
    fulltext: { columns: [roles.title] },
    // No joins: everything searchable lives on `roles` itself, so no DISTINCT is needed either.
};

const q = Astro.url.searchParams.get('q') ?? '';
const searchWhere = buildSearchWhere(parseSearchQuery(q), searchConfig);

const itemsPerPage = 12;
const pageData = z.coerce.number().int().positive().default(1).safeParse(Astro.url.searchParams.get("page") ?? 1);
let page = 1;
if (pageData.success) {
    page = pageData.data;
}
const offset = (page - 1) * itemsPerPage;

const [allRoles, totalRoles] = await Promise.all([
    db.select().from(roles).where(searchWhere).orderBy(desc(roles.id)).limit(itemsPerPage).offset(offset),
    db
        .select({ count: sql<number>`COUNT(*)` })
        .from(roles)
        .where(searchWhere)
        .then(result => result[0]?.count ?? 0),
]);

const totalPages = Math.ceil(totalRoles / itemsPerPage);
---

<AdminLayout>
	<div class="flex flex-wrap items-center justify-between gap-3 align-middle border-b border-base-300 pt-2 sticky top-0 z-10 bg-base-200">
        <h1 class="text-2xl font-semibold">Roles</h1>
        <a href="/admin/users/roles/new" class="btn btn-primary">New</a>
    </div>
    <div class="pt-4 pb-6">
        <SearchBar client:load fields={searchFields} defaultValue={q} className="w-full" />
    </div>
    <form id="bulk-form" method="POST"></form>
    {allRoles.length === 0 && (
        <div class="text-center text-base-content/60 py-8 bg-base-100 rounded-lg">
            {q ? 'No roles match your search.' : 'No roles yet.'}
        </div>
    )}
    {allRoles.length > 0 && (
        <>
    <table class="hidden sm:table p-2 bg-base-100 rounded-lg">
        <thead>
            <tr class="hidden [table:has(.row-select:checked)_&]:table-row">
                <th class="w-px whitespace-nowrap">
                    <label>
                        <input type="checkbox" class="checkbox select-all" />
                    </label>
                </th>
                <th colspan="3">
                    <div class="flex items-center gap-2">
                        <button form="bulk-form" type="submit" formaction="/admin/users/roles/bulk/publish" class="btn btn-xs btn-outline btn-accent">Enable</button>
                        <button form="bulk-form" type="submit" formaction="/admin/users/roles/bulk/unpublish" class="btn btn-xs btn-outline btn-warning">Disable</button>
                        <button form="bulk-form" type="submit" formaction="/admin/users/roles/bulk/delete" class="btn btn-xs btn-error">Delete</button>
                    </div>
                </th>
            </tr>
            <tr class="[table:has(.row-select:checked)_&]:hidden">
                <th class="w-px whitespace-nowrap">
                    <label>
                        <input type="checkbox" class="checkbox select-all" />
                    </label>
                </th>
                <th class="w-px whitespace-nowrap">State</th>
                <th class="w-1/2">Title</th>
                <th class="w-1/2">Admin Access</th>
            </tr>
        </thead>
        <tbody>
            {allRoles.map(role => (
                <tr>
                    <td>
                        <label>
                            <input
                                form="bulk-form"
                                type="checkbox"
                                class="checkbox row-select"
                                name="selected[]"
                                value={role.id}
                            />
                        </label>
                    </td>
                    <td class="w-px whitespace-nowrap">
                        <form action={`/admin/users/roles/toggle/${role.id}`} method="POST">
                            <button class="btn btn-square" type="submit">
                                {role.state === 1 ? <CircleCheck size={20} class="text-green-500" /> : <CircleX size={20} class="text-red-500" />}
                            </button>
                        </form>
                    </td>
                    <td class="w-1/2">
                        <a href={`/admin/users/roles/edit/${role.id}`}>
                            <span class="font-bold link-info link-hover">{role.title}</span>
                        </a>
                    </td>
                    <td class="w-1/2">
                        {role.adminAccess
                            ? <span class="badge badge-success badge-sm">Yes</span>
                            : <span class="badge badge-ghost badge-sm">No</span>}
                    </td>
                </tr>
            ))}
        </tbody>
    </table>

    <div class="sm:hidden admin-cards flex flex-col gap-3">
        <div class="hidden items-center gap-2 bg-base-100 rounded-lg p-3 [.admin-cards:has(.row-select:checked)_&]:flex">
            <label>
                <input type="checkbox" class="checkbox select-all" />
            </label>
            <button form="bulk-form" type="submit" formaction="/admin/users/roles/bulk/publish" class="btn btn-xs btn-outline btn-accent">Enable</button>
            <button form="bulk-form" type="submit" formaction="/admin/users/roles/bulk/unpublish" class="btn btn-xs btn-outline btn-warning">Disable</button>
            <button form="bulk-form" type="submit" formaction="/admin/users/roles/bulk/delete" class="btn btn-xs btn-error">Delete</button>
        </div>
        <div class="flex items-center gap-2 bg-base-100 rounded-lg p-3 [.admin-cards:has(.row-select:checked)_&]:hidden">
            <label class="flex items-center gap-2">
                <input type="checkbox" class="checkbox select-all" />
                <span class="text-sm text-base-content/60">Select all</span>
            </label>
        </div>
        {allRoles.map(role => (
            <div class="card bg-base-100 rounded-lg p-4">
                <div class="flex items-center justify-between gap-2 pb-3 mb-3 border-b border-base-300">
                    <label class="flex items-center gap-2">
                        <input
                            form="bulk-form"
                            type="checkbox"
                            class="checkbox row-select"
                            name="selected[]"
                            value={role.id}
                        />
                        <span class="text-sm text-base-content/60">Select</span>
                    </label>
                    <form action={`/admin/users/roles/toggle/${role.id}`} method="POST">
                        <button class="btn btn-square btn-sm" type="submit">
                            {role.state === 1 ? <CircleCheck size={18} class="text-green-500" /> : <CircleX size={18} class="text-red-500" />}
                        </button>
                    </form>
                </div>
                <dl class="flex flex-col gap-2">
                    <div class="flex justify-between gap-4">
                        <dt class="text-sm text-base-content/60">Title</dt>
                        <dd class="text-right">
                            <a href={`/admin/users/roles/edit/${role.id}`}>
                                <span class="font-bold link-info link-hover">{role.title}</span>
                            </a>
                        </dd>
                    </div>
                    <div class="flex justify-between gap-4">
                        <dt class="text-sm text-base-content/60">Admin Access</dt>
                        <dd class="text-right">
                            {role.adminAccess
                                ? <span class="badge badge-success badge-sm">Yes</span>
                                : <span class="badge badge-ghost badge-sm">No</span>}
                        </dd>
                    </div>
                </dl>
            </div>
        ))}
    </div>
        </>
    )}
    {totalRoles - allRoles.length > 0 &&
        <div class="pt-6 pb-6 flex items-center justify-center">
            <Pagination currentPage={page} totalPages={totalPages} basePath="/admin/users/roles/" params={{ q }} />
        </div>
    }
    <script>import '../../../../scripts/select-all'</script>
</AdminLayout>
