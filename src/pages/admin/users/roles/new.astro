---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import Form from '../../../../form/Form.astro';
import { getAllFields } from '../../../../form/index.js';
import { getDb } from '../../../../db/db.js';
import { roles } from '../../../../db/schema.js';
import { eq, getTableColumns, type InferSelectModel } from 'drizzle-orm';
import { getRoleForm } from './form.js';
import { createFormFlashSession } from '../../../../form/session.js';

const db = getDb();
const { id } = Astro.params;

let role: InferSelectModel<typeof roles>;
if (id) {
    const [existing] = await db.select().from(roles).where(eq(roles.id, id)).limit(1);
    if (!existing) {
        throw new Error('Role not found');
    }
    role = existing;
} else {
    role = Object.fromEntries(
        Object.entries(getTableColumns(roles)).map(([key, col]: [string, any]) => {
            let value: unknown;
            if (col.defaultFn !== undefined) value = col.defaultFn();
            else if (col.default !== undefined) value = col.default;
            else if (col.dataType === 'number') value = 0;
            else if (col.dataType === 'boolean') value = false;
            else value = '';
            return [key, value];
        })
    ) as InferSelectModel<typeof roles>;
}

const fields = getAllFields();
const formFlash = createFormFlashSession(Astro.session);
const flash = await formFlash.get('role') ?? {};
await formFlash.delete('role');

const url = id ? `/admin/users/roles/update/${id}` : '/admin/users/roles/update';
const form = getRoleForm(role, fields, url, flash);
const isNew = !id;
---

<AdminLayout>
    <Form form={form} fields={fields}>
        <div slot="before-fields" class="flex items-center justify-between align-middle pt-2">
            <h1 class="text-2xl font-semibold">{isNew ? 'New Role' : 'Edit Role'}</h1>
            <div class="flex items-center gap-2">
                <button class="btn btn-primary">Save</button>
            </div>
        </div>
    </Form>
</AdminLayout>
