---
import { ANALYTICS_SETTING_KEY, analyticsProviders, normalizeAnalyticsSettings } from '../../../../analytics/index.js';
import { getSetting } from '../../../../db/content-cache.js';
import { getDb } from '../../../../db/db.js';
import { createFormFlashSession } from '../../../../form/session.js';
import AdminLayout from '../../../../layouts/AdminLayout.astro';

// Analytics & tracking providers (see analytics/providers.ts). Each enabled provider's snippet is
// added to every public page and both 404 pages by components/Analytics.astro.
const saved = normalizeAnalyticsSettings(await getSetting(getDb(), ANALYTICS_SETTING_KEY));

// After a failed save, the submitted values come back so nothing typed is lost.
const formFlash = createFormFlashSession(Astro.session);
const flash = await formFlash.get('analytics');
await formFlash.delete('analytics');

const providers = analyticsProviders.map((provider) => {
    const stored = saved[provider.id];
    return {
        provider,
        enabled: flash ? flash[`${provider.id}-enabled`] === 'on' : stored?.enabled ?? false,
        values: Object.fromEntries(provider.fields.map((field) => [
            field.name,
            flash ? flash[`${provider.id}-${field.name}`] ?? '' : stored?.values[field.name] ?? '',
        ])),
    };
});
const enabledCount = providers.filter((p) => p.enabled).length;
---

<AdminLayout>
	<form method="POST" action="/admin/settings/analytics/save" class="space-y-6">
		<div class="flex flex-wrap items-center justify-between gap-3 border-b border-base-300 pt-2 pb-2 sticky top-0 z-10 bg-base-200">
			<div>
				<h1 class="text-2xl font-semibold">Analytics</h1>
				<p class="text-sm text-base-content/70">
					Tracking and monitoring scripts added to every public page, including the 404 page.
					{enabledCount > 0 ? ` ${enabledCount} enabled.` : ' None enabled.'}
				</p>
			</div>
			<button class="btn btn-primary">Save</button>
		</div>

		{providers.map(({ provider, enabled, values }) => (
			<section class="p-6 bg-base-100 rounded-lg" id={`provider-${provider.id}`}>
				<div class="flex items-start justify-between gap-4">
					<div>
						<h2 class="text-lg font-medium">{provider.name}</h2>
						<p class="text-sm text-base-content/70">
							{provider.description}{' '}
							<a href={provider.docsUrl} target="_blank" rel="noopener noreferrer" class="link">Setup guide</a>
						</p>
					</div>
					<label class="flex items-center gap-2 cursor-pointer shrink-0">
						<span class="text-sm">Enabled</span>
						<input type="checkbox" class="toggle toggle-primary" name={`${provider.id}-enabled`} checked={enabled} />
					</label>
				</div>
				<div class="grid grid-cols-1 gap-4 lg:grid-cols-2 lg:gap-6 mt-6">
					{provider.fields.map((field) => (
						<label class="flex flex-col gap-1" for={`${provider.id}-${field.name}`}>
							<span class="text-md font-medium">
								{field.label}
								{field.optional && <span class="text-base-content/60 font-normal"> (optional)</span>}
							</span>
							<input
								type="text"
								id={`${provider.id}-${field.name}`}
								name={`${provider.id}-${field.name}`}
								value={values[field.name]}
								placeholder={field.placeholder}
								autocomplete="off"
								spellcheck="false"
								class="input input-bordered w-full"
							/>
							{field.description && <span class="text-sm text-base-content/70">{field.description}</span>}
						</label>
					))}
				</div>
			</section>
		))}
	</form>
</AdminLayout>
