---
import externalPuckConfig from 'virtual:purplepanda/puck-config';
import { eq, inArray } from 'drizzle-orm';
import { getDb } from '../../../db/db.js';
import { settings } from '../../../db/schema.js';
import Form from '../../../form/Form.astro';
import { getAllFields } from '../../../form/index.js';
import { createFormFlashSession } from '../../../form/session.js';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getSettingsForm } from './form.js';

const db = getDb();

const [defaultTemplateSetting] = await db.select().from(settings).where(eq(settings.key, 'default_template')).limit(1);
const defaultTemplateId = defaultTemplateSetting?.value as string | undefined;

const [siteNameSetting] = await db.select().from(settings).where(eq(settings.key, 'site_name')).limit(1);
const siteName = siteNameSetting?.value as string | undefined;

const turnstileSettings = await db.select().from(settings).where(inArray(settings.key, ['turnstile_site_key', 'turnstile_secret_key']));
const turnstileSiteKey = turnstileSettings.find(s => s.key === 'turnstile_site_key')?.value as string | undefined;
const turnstileSecretKey = turnstileSettings.find(s => s.key === 'turnstile_secret_key')?.value as string | undefined;

const fontSettings = await db.select().from(settings).where(inArray(settings.key, ['heading_font_link', 'body_font_link']));
const headingFontLink = fontSettings.find(s => s.key === 'heading_font_link')?.value as string | undefined;
const bodyFontLink = fontSettings.find(s => s.key === 'body_font_link')?.value as string | undefined;

const emailSettings = await db.select().from(settings).where(inArray(settings.key, ['email_host', 'email_address', 'email_password']));
const emailHost = emailSettings.find(s => s.key === 'email_host')?.value as string | undefined;
const emailAddress = emailSettings.find(s => s.key === 'email_address')?.value as string | undefined;
const emailPassword = emailSettings.find(s => s.key === 'email_password')?.value as string | undefined;
const fontFamilies = externalPuckConfig?.fontFamilies ?? [];
const contentTypes = (externalPuckConfig?.contentTypes ?? []);
const contentSettingsKeys = contentTypes.map((ct) => `content_default_template_${ct.id}`);
const contentSettings = contentSettingsKeys.length > 0
	? await db.select().from(settings).where(inArray(settings.key, contentSettingsKeys))
	: [];
const contentTemplateDefaults = Object.fromEntries(
	contentTypes.map((ct) => [
		ct.id,
		(contentSettings.find((s) => s.key === `content_default_template_${ct.id}`)?.value as string | undefined) ?? '',
	]),
);

const fields = getAllFields();
const formFlash = createFormFlashSession(Astro.session);
const flash = await formFlash.get('settings') ?? {};
await formFlash.delete('settings');
const form = getSettingsForm(
	defaultTemplateId,
	turnstileSiteKey,
	turnstileSecretKey,
	flash,
	contentTypes,
	contentTemplateDefaults,
	headingFontLink,
	bodyFontLink,
	fontFamilies,
	siteName,
	emailHost,
	emailAddress,
	emailPassword,
);
---

<AdminLayout>
	<Form form={form} fields={fields}>
		<div slot="before-fields" class="flex flex-wrap items-center justify-between gap-3 align-middle border-b border-base-300 pt-2 sticky top-0 z-10 bg-base-200">
			<h1 class="text-2xl font-semibold">Settings</h1>
			<button class="btn btn-primary">Save</button>
		</div>
		<div slot="before-fields" class="pt-4 pb-6">
			<input
				type="text"
				id="settings-search"
				placeholder="Search settings..."
				class="input input-bordered w-full"
				autocomplete="off"
			/>
		</div>
	</Form>
</AdminLayout>

<style is:global>
	@keyframes settings-anchor-flash {
		0% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.6); border-radius: 0.5rem; }
		100% { box-shadow: 0 0 0 8px rgba(59, 130, 246, 0); border-radius: 0.5rem; }
	}
	.settings-anchor-flash {
		animation: settings-anchor-flash 1.4s ease-out;
	}
</style>

<script>
	const searchInput = document.getElementById('settings-search') as HTMLInputElement | null;
	const sections = document.querySelectorAll<HTMLElement>('.settings-search-section');

	searchInput?.addEventListener('keydown', (e) => {
		if (e.key === 'Enter') e.preventDefault();
	});

	async function flashAnchorTarget() {
		const hash = window.location.hash.slice(1);
		if (!hash) return;
		const target = document.getElementById(hash);
		if (!target) return;

		// The Heading/Body Font fields preview their selection via a real webfont <link>, loaded
		// after first paint. Once that font arrives the sample text reflows and shifts everything
		// below it — scrolling too early gets silently undone by that shift a moment later. Wait
		// for fonts to settle (and bail out after a beat if that promise never resolves) before
		// scrolling, so the shift happens before we position the target rather than after.
		await Promise.race([
			document.fonts?.ready ?? Promise.resolve(),
			new Promise((resolve) => setTimeout(resolve, 1000)),
		]);

		// The page body scrolls inside a nested `.drawer-content` (not the document itself), which
		// native fragment-navigation scrolling doesn't reliably reach — so drive it explicitly
		// instead of assuming the browser already brought the target into view.
		target.scrollIntoView({ behavior: 'smooth', block: 'center' });
		target.classList.remove('settings-anchor-flash');
		// Force reflow so re-triggering the flash (e.g. clicking the same anchor link twice) restarts the animation.
		void target.offsetWidth;
		target.classList.add('settings-anchor-flash');
		target.addEventListener('animationend', () => {
			target.classList.remove('settings-anchor-flash');
		}, { once: true });
	}

	flashAnchorTarget();
	window.addEventListener('hashchange', flashAnchorTarget);

	searchInput?.addEventListener('input', () => {
		const query = searchInput.value.trim().toLowerCase();
		sections.forEach((section) => {
			const labels = section.querySelectorAll('.settings-search-label');
			const matches = query === '' || Array.from(labels).some((label) =>
				label.textContent?.toLowerCase().includes(query)
			);
			section.classList.toggle('hidden', !matches);
		});
	});

	const testEmailButton = document.getElementById('email-test-credentials') as HTMLButtonElement | null;
	const testEmailResult = document.getElementById('email-test-result') as HTMLSpanElement | null;
	const emailHostInput = document.getElementById('email-host') as HTMLInputElement | null;
	const emailAddressInput = document.getElementById('email-address') as HTMLInputElement | null;
	const emailPasswordInput = document.getElementById('email-password') as HTMLInputElement | null;

	testEmailButton?.addEventListener('click', async () => {
		if (!testEmailResult) return;

		const host = emailHostInput?.value.trim() ?? '';
		const email = emailAddressInput?.value.trim() ?? '';
		const password = emailPasswordInput?.value ?? '';

		testEmailButton.disabled = true;
		testEmailResult.classList.remove('hidden', 'text-success', 'text-error');
		testEmailResult.classList.add('text-base-content/70');
		testEmailResult.textContent = 'Testing…';

		try {
			const response = await fetch('/admin/settings/api/test-email', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ host, email, password }),
			});
			const result = await response.json() as { success: boolean; message: string };

			testEmailResult.classList.remove('text-base-content/70');
			testEmailResult.classList.add(result.success ? 'text-success' : 'text-error');
			testEmailResult.textContent = result.message;
		} catch {
			testEmailResult.classList.remove('text-base-content/70');
			testEmailResult.classList.add('text-error');
			testEmailResult.textContent = 'Failed to reach the server.';
		} finally {
			testEmailButton.disabled = false;
		}
	});
</script>
