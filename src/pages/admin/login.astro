---
import { getDb } from '../../db/db.js';
import { getRootDomain, urlOnDomain } from '../../tenant/index.js';

// Every site signs in through the root site's /login (see auth/sso.ts), which hands the account back
// here, signed in, once it knows who they are — remembering which of this site's hostnames they
// came from.
const rootDomain = await getRootDomain(getDb());
if (!rootDomain) {
  return new Response('No root site is configured', { status: 503 });
}
const params = new URLSearchParams({ site: Astro.locals.tenant.id, host: Astro.url.hostname });
return Astro.redirect(urlOnDomain(Astro.url, rootDomain, `/login?${params}`));
---
