---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Form from '../../../form/Form.astro';
import { getAllFields } from '../../../form/index.js';
import { getDb } from '../../../db/db.js';
import { redirects } from '../../../db/schema.js';
import { eq, getTableColumns, type InferSelectModel } from 'drizzle-orm';
import { getRedirectForm } from './form.js';
import { createFormFlashSession } from '../../../form/session.js';

const db = getDb();
const { id } = Astro.params;

let redirect: InferSelectModel<typeof redirects>;
if (id) {
    const [existing] = await db.select().from(redirects).where(eq(redirects.id, id)).limit(1);
    if (!existing) {
        throw new Error('Redirect not found');
    }
    redirect = existing;
} else {
    redirect = Object.fromEntries(
        Object.entries(getTableColumns(redirects)).map(([key, col]: [string, any]) => {
            let value: unknown;
            if (col.defaultFn !== undefined) value = col.defaultFn();
            else if (col.default !== undefined) value = col.default;
            else if (col.dataType === 'number') value = 0;
            else value = '';
            return [key, value];
        })
    ) as InferSelectModel<typeof redirects>;
}

const fields = getAllFields();
const formFlash = createFormFlashSession(Astro.session);
const flash = await formFlash.get('redirect') ?? {};
await formFlash.delete('redirect');

const url = id ? `/admin/redirects/update/${id}` : '/admin/redirects/update';
const form = getRedirectForm(redirect, fields, url, flash);
const isNew = !id;
---

<AdminLayout>
    <Form form={form} fields={fields}>
        <div slot="before-fields" class="flex items-center justify-between align-middle pt-2">
            <h1 class="text-2xl font-semibold">{isNew ? 'New Redirect' : 'Edit Redirect'}</h1>
            <div class="flex items-center gap-2">
                <button class="btn btn-primary">Save</button>
            </div>
        </div>
    </Form>
</AdminLayout>
