---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../db/db.js';
import { redirects, userActions, users } from '../../../db/schema.js';
import { CircleCheck, CircleX } from '@lucide/astro';
import { desc, eq, sql } from 'drizzle-orm';
import { z } from 'zod';
import Pagination from '../../../components/Pagination.astro';
import SearchBar from '../../../search/SearchBar';
import { parseSearchQuery } from '../../../search/parser.js';
import { applySearchJoins, buildSearchWhere, type DrizzleSearchConfig } from '../../../search/drizzle.js';
import type { SearchFieldSpec } from '../../../search/types.js';

const db = getDb();

// Client-safe field descriptions passed to <SearchBar>: drive its validation, github-style
// valid/invalid highlighting, and the qualifier/value autocomplete dropdown.
const searchFields: SearchFieldSpec[] = [
    {
        name: 'state',
        type: 'enum',
        enumValues: ['enabled', 'disabled', 'deleted'],
        label: 'State',
        description: 'Enabled state',
    },
    { name: 'from', type: 'text', label: 'From', description: 'Source path (exact)' },
    { name: 'to', type: 'text', label: 'To', description: 'Destination path or URL (exact)' },
    { name: 'author', type: 'text', nullable: true, label: 'Author', description: 'Creator email (null = unattributed)' },
    { name: 'created', type: 'date', label: 'Created', description: 'Date created (YYYY-MM-DD)' },
];

// Server-side counterpart: resolves each field to a (possibly joined) column. `redirects` has no
// author or created-at column of its own, so both ride on the `redirectcreate` row that
// `update.ts` logs to `userActions` (`{ type: "redirectcreate", data: { id: <redirectId> } }`)
// whenever a redirect is created.
const searchConfig: DrizzleSearchConfig = {
    fields: [
        {
            name: 'state',
            type: 'enum',
            enumValues: ['enabled', 'disabled', 'deleted'],
            column: redirects.state,
            // "deleted" has no matching rows today (toggle.ts only ever flips state between 1 and
            // 0) — -1 is reserved here so a future soft-delete can slot in without a grammar change.
            valueMap: { enabled: 1, disabled: 0, deleted: -1 },
        },
        { name: 'from', type: 'text', column: redirects.from, matchMode: 'exact' },
        { name: 'to', type: 'text', column: redirects.to, matchMode: 'exact' },
        { name: 'author', type: 'text', nullable: true, column: users.email, matchMode: 'exact' },
        { name: 'created', type: 'date', column: userActions.date },
    ],
    // An unqualified term runs a single tsvector match across both columns at once.
    fulltext: { columns: [redirects.from, redirects.to] },
    joins: [
        {
            table: userActions,
            on: sql`${userActions.type} = 'redirectcreate' and ${userActions.data} ->> 'id' = ${redirects.id}::text`,
            type: 'left',
        },
        { table: users, on: eq(userActions.userId, users.id), type: 'left' },
    ],
};

const q = Astro.url.searchParams.get('q') ?? '';
const searchWhere = buildSearchWhere(parseSearchQuery(q), searchConfig);

const itemsPerPage = 12;
const pageData = z.coerce.number().int().positive().default(1).safeParse(Astro.url.searchParams.get("page") ?? 1);
let page = 1;
if (pageData.success) {
    page = pageData.data;
}
const offset = (page - 1) * itemsPerPage;

// DISTINCT (here and in the count below) because the userActions/users joins are one-to-many: a
// redirect with more than one `redirectcreate` action would otherwise be listed — and counted —
// once per matching action row.
const allRedirects = await applySearchJoins(
    db
        .selectDistinct({ id: redirects.id, state: redirects.state, from: redirects.from, to: redirects.to })
        .from(redirects)
        .$dynamic(),
    searchConfig.joins,
)
    .where(searchWhere)
    .orderBy(desc(redirects.id))
    .limit(itemsPerPage)
    .offset(offset);

const totalRedirects = await applySearchJoins(
    db.select({ count: sql<number>`COUNT(DISTINCT ${redirects.id})` }).from(redirects).$dynamic(),
    searchConfig.joins,
)
    .where(searchWhere)
    .then(result => result[0]?.count ?? 0);
const totalPages = Math.ceil(totalRedirects / itemsPerPage);
---

<AdminLayout>
	<div class="flex items-center justify-between align-middle border-b border-base-300 pt-2 pb-4">
        <h1 class="text-2xl font-semibold">Redirects</h1>
        <a href="/admin/redirects/new" class="btn btn-primary">New</a>
    </div>
    <div class="pt-4 pb-6">
        <SearchBar client:load fields={searchFields} defaultValue={q} className="w-full" />
    </div>
    <form id="bulk-form" method="POST"></form>
    {allRedirects.length === 0 && (
        <div class="text-center text-base-content/60 py-8 bg-base-100 rounded-lg">
            {q ? 'No redirects match your search.' : 'No redirects yet.'}
        </div>
    )}
    {allRedirects.length > 0 && (
        <>
            <table class="hidden sm:table p-2 bg-base-100 rounded-lg">
                <thead>
                    <tr class="hidden [table:has(.row-select:checked)_&]:table-row">
                        <th class="w-px whitespace-nowrap">
                            <label>
                                <input type="checkbox" class="checkbox select-all" />
                            </label>
                        </th>
                        <th colspan="3">
                            <div class="flex items-center gap-2">
                                <button form="bulk-form" type="submit" formaction="/admin/redirects/bulk/publish" class="btn btn-xs btn-outline btn-accent">Enable</button>
                                <button form="bulk-form" type="submit" formaction="/admin/redirects/bulk/unpublish" class="btn btn-xs btn-outline btn-warning">Disable</button>
                                <button form="bulk-form" type="submit" formaction="/admin/redirects/bulk/delete" class="btn btn-xs btn-error">Delete</button>
                            </div>
                        </th>
                    </tr>
                    <tr class="[table:has(.row-select:checked)_&]:hidden">
                        <th class="w-px whitespace-nowrap">
                            <label>
                                <input type="checkbox" class="checkbox select-all" />
                            </label>
                        </th>
                        <th class="w-px whitespace-nowrap">State</th>
                        <th>From</th>
                        <th>To</th>
                    </tr>
                </thead>
                <tbody>
                    {allRedirects.map(redirect => (
                        <tr>
                            <td>
                                <label>
                                    <input
                                        form="bulk-form"
                                        type="checkbox"
                                        class="checkbox row-select"
                                        name="selected[]"
                                        value={redirect.id}
                                    />
                                </label>
                            </td>
                            <td class="w-px whitespace-nowrap">
                                <form action={`/admin/redirects/toggle/${redirect.id}`} method="POST">
                                    <button class="btn btn-square" type="submit">
                                        {redirect.state === 1 ? <CircleCheck size={20} class="text-green-500" /> : <CircleX size={20} class="text-red-500" />}
                                    </button>
                                </form>
                            </td>
                            <td>
                                <a href={`/admin/redirects/edit/${redirect.id}`}>
                                    <div class="font-bold link-info link-hover">{redirect.from}</div>
                                </a>
                            </td>
                            <td class="text-base-content/70">{redirect.to}</td>
                        </tr>
                    ))}
                </tbody>
            </table>

            <div class="sm:hidden admin-cards flex flex-col gap-3">
                <div class="hidden items-center gap-2 bg-base-100 rounded-lg p-3 [.admin-cards:has(.row-select:checked)_&]:flex">
                    <label>
                        <input type="checkbox" class="checkbox select-all" />
                    </label>
                    <button form="bulk-form" type="submit" formaction="/admin/redirects/bulk/publish" class="btn btn-xs btn-outline btn-accent">Enable</button>
                    <button form="bulk-form" type="submit" formaction="/admin/redirects/bulk/unpublish" class="btn btn-xs btn-outline btn-warning">Disable</button>
                    <button form="bulk-form" type="submit" formaction="/admin/redirects/bulk/delete" class="btn btn-xs btn-error">Delete</button>
                </div>
                <div class="flex items-center gap-2 bg-base-100 rounded-lg p-3 [.admin-cards:has(.row-select:checked)_&]:hidden">
                    <label class="flex items-center gap-2">
                        <input type="checkbox" class="checkbox select-all" />
                        <span class="text-sm text-base-content/60">Select all</span>
                    </label>
                </div>
                {allRedirects.map(redirect => (
                    <div class="card bg-base-100 rounded-lg p-4">
                        <div class="flex items-center justify-between gap-2 pb-3 mb-3 border-b border-base-300">
                            <label class="flex items-center gap-2">
                                <input
                                    form="bulk-form"
                                    type="checkbox"
                                    class="checkbox row-select"
                                    name="selected[]"
                                    value={redirect.id}
                                />
                                <span class="text-sm text-base-content/60">Select</span>
                            </label>
                            <form action={`/admin/redirects/toggle/${redirect.id}`} method="POST">
                                <button class="btn btn-square btn-sm" type="submit">
                                    {redirect.state === 1 ? <CircleCheck size={18} class="text-green-500" /> : <CircleX size={18} class="text-red-500" />}
                                </button>
                            </form>
                        </div>
                        <dl class="flex flex-col gap-2">
                            <div class="flex justify-between gap-4">
                                <dt class="text-sm text-base-content/60">From</dt>
                                <dd class="text-right">
                                    <a href={`/admin/redirects/edit/${redirect.id}`}>
                                        <span class="font-bold link-info link-hover">{redirect.from}</span>
                                    </a>
                                </dd>
                            </div>
                            <div class="flex justify-between gap-4">
                                <dt class="text-sm text-base-content/60">To</dt>
                                <dd class="text-right text-base-content/70 break-all">{redirect.to}</dd>
                            </div>
                        </dl>
                    </div>
                ))}
            </div>
        </>
    )}
    {totalRedirects - allRedirects.length > 0 &&
        <div class="pt-6 pb-6 flex items-center justify-center">
            <Pagination currentPage={page} totalPages={totalPages} basePath="/admin/redirects/" params={{ q }} />
        </div>
    }
    <script>import '../../../scripts/select-all'</script>
</AdminLayout>
