---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../db/db.js';
import { pages, dagNodes, userActions, users } from '../../../db/schema.js';
import { CircleCheck, CircleX, EllipsisVertical, FilePen, Trash2, GitBranch, CornerDownRight } from '@lucide/astro';
import { desc, isNull, and, or, eq, gt, sql, type InferSelectModel } from 'drizzle-orm';
import { alias } from 'drizzle-orm/pg-core';
import { z } from 'zod';
import Pagination from '../../../components/Pagination.astro';
import SearchBar from '../../../search/SearchBar';
import { parseSearchQuery } from '../../../search/parser.js';
import { applySearchJoins, buildSearchWhere, type DrizzleSearchConfig } from '../../../search/drizzle.js';
import type { SearchFieldSpec } from '../../../search/types.js';

type Page = InferSelectModel<typeof pages>;

const db = getDb();

// Neither the title nor the parent link is a column — Puck stores both inside the content document,
// which is why the table below reads `content.root.props.*`. The search builder accepts arbitrary
// SQL expressions in place of columns, so the same paths can be filtered on directly in Postgres.
const titleExpr = sql`${pages.content} -> 'root' -> 'props' ->> 'title'`;
const parentPageExpr = sql`${pages.content} -> 'root' -> 'props' ->> 'parentPage'`;

// This listing is only the plain pages (content-typed rows live under /admin/content) and hides
// soft-deleted ones.
const visibleScope = and(isNull(pages.contentType), gt(pages.state, -1));

// Self-join so a page can be filtered by its parent's title, and so `parent:null` finds top-level
// pages. Scoped to visible parents so a page whose parent was deleted reads as top level — which is
// exactly how the tree below already treats an unresolvable parent.
const parentPages = alias(pages, 'parent_pages');
// The parent's title lives inside its own content document, exactly like this page's does.
const parentTitleExpr = sql`${parentPages.content} -> 'root' -> 'props' ->> 'title'`;

// Client-safe field descriptions passed to <SearchBar>: drive its validation, github-style
// valid/invalid highlighting, and the qualifier/value autocomplete dropdown.
const searchFields: SearchFieldSpec[] = [
    {
        name: 'state',
        type: 'enum',
        enumValues: ['published', 'unpublished'],
        label: 'State',
        description: 'Publish state',
    },
    { name: 'title', type: 'text', label: 'Title', description: 'Title contains' },
    { name: 'parent', type: 'text', nullable: true, label: 'Parent', description: 'Parent page (null = top level)' },
    { name: 'author', type: 'text', nullable: true, label: 'Author', description: 'Creator email (null = unattributed)' },
    { name: 'created', type: 'date', label: 'Created', description: 'Date created (YYYY-MM-DD)' },
];

// `pages` has no author or created-at column, so both ride on the `pagecreate` row that
// `pages/update.ts` logs to `userActions` (`{ type: "pagecreate", data: { id: <pageId> } }`).
const searchConfig: DrizzleSearchConfig = {
    fields: [
        {
            name: 'state',
            type: 'enum',
            enumValues: ['published', 'unpublished'],
            column: pages.state,
            valueMap: { published: 1, unpublished: 0 },
        },
        { name: 'title', type: 'text', column: titleExpr, matchMode: 'contains' },
        { name: 'parent', type: 'text', nullable: true, column: parentTitleExpr, matchMode: 'contains' },
        { name: 'author', type: 'text', nullable: true, column: users.email, matchMode: 'exact' },
        { name: 'created', type: 'date', column: userActions.date },
    ],
    fulltext: { columns: [titleExpr] },
    joins: [
        {
            table: parentPages,
            on: sql`${parentPages.id}::text = ${parentPageExpr} and ${parentPages.contentType} is null and ${parentPages.state} > -1`,
            type: 'left',
        },
        {
            table: userActions,
            on: sql`${userActions.type} = 'pagecreate' and ${userActions.data} ->> 'id' = ${pages.id}::text`,
            type: 'left',
        },
        { table: users, on: eq(userActions.userId, users.id), type: 'left' },
    ],
};

const q = Astro.url.searchParams.get('q') ?? '';
const isSearching = q.trim().length > 0;
const searchWhere = buildSearchWhere(parseSearchQuery(q), searchConfig);

const itemsPerPage = 12;
const pageData = z.coerce.number().int().positive().default(1).safeParse(Astro.url.searchParams.get("page") ?? 1);
// Named `currentPage`/`totalPageCount` rather than the usual `page`/`totalPages` because the rows
// being listed are themselves `pages`, and the table's map callback already binds `page` per row.
let currentPage = 1;
if (pageData.success) {
    currentPage = pageData.data;
}
const offset = (currentPage - 1) * itemsPerPage;

// A page sits at the root if it names no parent, or if that parent isn't itself visible here —
// mirroring how the tree treats a parent it can't resolve.
const isRootPage = or(
    sql`${parentPageExpr} is null`,
    sql`not exists (
        select 1 from ${pages} ancestor
        where ancestor.id::text = ${parentPageExpr}
          and ancestor."contentType" is null
          and ancestor.state > -1
    )`,
);

let orderedPages: { page: Page; depth: number }[] = [];
let totalItems = 0;
let allDrafts: InferSelectModel<typeof dagNodes>[] = [];

if (isSearching) {
    // Filtering inevitably breaks the parent/child chain (a match's parent may not match), so
    // results are shown flat rather than silently rendering orphans at the wrong depth.
    // DISTINCT because the userActions join is one-to-many.
    const [rows, total, drafts] = await Promise.all([
        applySearchJoins(db.selectDistinct({ ...pageColumns() }).from(pages).$dynamic(), searchConfig.joins)
            .where(and(visibleScope, searchWhere))
            .orderBy(desc(pages.id))
            .limit(itemsPerPage)
            .offset(offset),
        applySearchJoins(
            db.select({ count: sql<number>`COUNT(DISTINCT ${pages.id})` }).from(pages).$dynamic(),
            searchConfig.joins,
        )
            .where(and(visibleScope, searchWhere))
            .then(result => result[0]?.count ?? 0),
        draftsQuery(),
    ]);
    orderedPages = rows.map(row => ({ page: row as Page, depth: 1 }));
    totalItems = total;
    allDrafts = drafts;
} else {
    // Paginating raw rows would split a subtree across pages, leaving children stranded and drawn
    // as if they were top level. Paginating by ROOT instead keeps every subtree whole, so a page
    // may render more rows than `itemsPerPage` — the page size counts roots, not pages.
    const [rootPage, totalRoots, everyPage, drafts] = await Promise.all([
        db.select().from(pages).where(and(visibleScope, isRootPage)).orderBy(desc(pages.id)).limit(itemsPerPage).offset(offset),
        db.select({ count: sql<number>`COUNT(*)` }).from(pages).where(and(visibleScope, isRootPage)).then(r => r[0]?.count ?? 0),
        db.select().from(pages).where(visibleScope).orderBy(desc(pages.id)),
        draftsQuery(),
    ]);

    const childrenByParent = new Map<string, Page[]>();
    for (const candidate of everyPage) {
        const parentPage = (candidate.content as any)?.root?.props?.parentPage;
        if (!parentPage) continue;
        if (!childrenByParent.has(parentPage)) childrenByParent.set(parentPage, []);
        childrenByParent.get(parentPage)!.push(candidate);
    }

    // `visited` guards against a parent cycle, which nothing in the content document prevents.
    function addChildren(parentId: string, depth: number, visited: Set<string>) {
        for (const child of childrenByParent.get(parentId) ?? []) {
            if (visited.has(child.id)) continue;
            orderedPages.push({ page: child, depth });
            addChildren(child.id, depth + 1, new Set(visited).add(child.id));
        }
    }

    for (const root of rootPage) {
        orderedPages.push({ page: root, depth: 1 });
        addChildren(root.id, 2, new Set([root.id]));
    }
    totalItems = totalRoots;
    allDrafts = drafts;
}

function pageColumns() {
    return { id: pages.id, state: pages.state, contentType: pages.contentType, content: pages.content };
}

function draftsQuery() {
    return db
        .select()
        .from(dagNodes)
        .where(and(eq(dagNodes.entityType, 'page'), eq(dagNodes.nodeType, 'draft'), eq(dagNodes.state, 1)))
        .orderBy(desc(dagNodes.createdAt));
}

const draftsByPageId = allDrafts.reduce<Record<string, typeof allDrafts>>((acc, draft) => {
    const bucket = acc[draft.entityId];
    if (bucket !== undefined) {
        bucket.push(draft);
    } else {
        acc[draft.entityId] = [draft];
    }
    return acc;
}, {});

const totalPageCount = Math.ceil(totalItems / itemsPerPage);
---

<AdminLayout>
	<div class="flex items-center justify-between align-middle border-b border-base-300 pt-2 pb-4">
        <h1 class="text-2xl font-semibold">Pages</h1>
        <a href="/admin/pages/new" class="btn btn-primary">New</a>
    </div>
    <div class="pt-4 pb-6">
        <SearchBar client:load fields={searchFields} defaultValue={q} className="w-full" />
    </div>
    <form id="bulk-form" method="POST"></form>
    <table class="table p-2 bg-base-100 rounded-lg">
        <thead>
            <tr class="hidden [table:has(.row-select:checked)_&]:table-row">
                <th class="w-px whitespace-nowrap">
                    <label>
                        <input type="checkbox" class="checkbox select-all" />
                    </label>
                </th>
                <th colspan="3">
                    <div class="flex items-center gap-2">
                        <button form="bulk-form" type="submit" formaction="/admin/pages/bulk/publish" class="btn btn-xs btn-outline btn-accent">Publish</button>
                        <button form="bulk-form" type="submit" formaction="/admin/pages/bulk/unpublish" class="btn btn-xs btn-outline btn-warning">Unpublish</button>
                        <button form="bulk-form" type="submit" formaction="/admin/pages/bulk/delete" class="btn btn-xs btn-error">Delete</button>
                    </div>
                </th>
            </tr>
            <tr class="[table:has(.row-select:checked)_&]:hidden">
                <th class="w-px whitespace-nowrap">
                    <label>
                        <input type="checkbox" class="checkbox select-all" />
                    </label>
                </th>
                <th class="w-px whitespace-nowrap">State</th>
                <th>Page</th>
                <th class="w-px whitespace-nowrap"></th>
            </tr>
        </thead>
        <tbody>
            {orderedPages.length === 0 && (
                <tr>
                    <td colspan="4" class="text-center text-base-content/60 py-8">
                        {q ? 'No pages match your search.' : 'No pages yet.'}
                    </td>
                </tr>
            )}
            {orderedPages.map(({ page, depth }) => {
                const drafts = draftsByPageId[page.id] ?? [];
                return (
                    <tr>
                        <td>
                            <label>
                                <input
                                    form="bulk-form"
                                    type="checkbox"
                                    class="checkbox row-select"
                                    name="selected[]"
                                    value={page.id}
                                />
                            </label>
                        </td>
                        <td class="w-px whitespace-nowrap">
                            <form action={`/admin/pages/toggle/${page.id}`} method="POST">
                                <button class="btn btn-square" type="submit">
                                    {page.state === 1 ? <CircleCheck size={20} class="text-green-500" /> : <CircleX size={20} class="text-red-500" />}
                                </button>
                            </form>
                        </td>
                        <td>
                            <a href={`/admin/pages/edit/${page.id}`}>
                                <div class="font-bold flex items-center gap-1">
                                    {depth > 1 && <span class="whitespace-pre">{' '.repeat((depth - 2) * 2)}</span>}
                                    {depth > 1 && <CornerDownRight size={14} class="text-base-content/50 shrink-0" />}
                                    <span class="link-info link-hover">{(page.content as any)?.root?.props?.title || 'Untitled'}</span>
                                </div>
                            </a>
                        </td>
                        <td class="w-px whitespace-nowrap">
                            <div class="dropdown dropdown-end">
                                <div tabindex="0" role="button" class="btn btn-ghost btn-sm btn-square">
                                    <EllipsisVertical size={16} />
                                </div>
                                <ul tabindex="0" class="dropdown-content menu bg-base-200 rounded-box z-10 w-56 p-2 shadow-lg border border-base-300">
                                    {drafts.length > 0 ? (
                                        <>
                                            <li class="menu-title text-xs text-base-content/60 px-2 py-1">Drafts</li>
                                            {drafts.map(draft => (
                                                <li>
                                                    <div class="flex items-center gap-1 pr-1">
                                                        <a href={`/admin/pages/drafts/edit/${draft.id}`} class="flex items-center gap-2 flex-1 min-w-0" title={draft.name}>
                                                            <FilePen size={14} class="shrink-0" />
                                                            <span class="truncate min-w-0">{draft.name}</span>
                                                        </a>
                                                        <form method="POST" action={`/admin/drafts/delete/${draft.id}`}>
                                                            <button type="submit" class="btn btn-ghost btn-xs btn-square text-error shrink-0" title="Delete draft">
                                                                <Trash2 size={12} />
                                                            </button>
                                                        </form>
                                                    </div>
                                                </li>
                                            ))}
                                            <li><hr class="my-1 border-base-300" /></li>
                                        </>
                                    ) : null}
                                    <li>
                                        <button
                                            type="button"
                                            class="gap-2"
                                            data-create-draft
                                            data-entity-id={page.id}
                                            data-entity-type="page"
                                        >
                                            <FilePen size={14} />
                                            Create new draft
                                        </button>
                                    </li>
                                    <li>
                                        <a href={`/admin/pages/history/${page.id}`} class="gap-2">
                                            <GitBranch size={12} />
                                            History
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                );
            })}
        </tbody>
    </table>
    {totalPageCount > 1 &&
        <div class="pt-6 pb-6 flex items-center justify-center">
            <Pagination currentPage={currentPage} totalPages={totalPageCount} basePath="/admin/pages/" params={{ q }} />
        </div>
    }

    <!-- Create Draft Modal -->
    <dialog id="create-draft-modal" class="modal">
        <div class="modal-box">
            <h3 class="font-bold text-lg mb-4">Create New Draft</h3>
            <form method="POST" action="/admin/drafts/create" id="create-draft-form">
                <input type="hidden" name="entityId" id="draft-entity-id" />
                <input type="hidden" name="entityType" id="draft-entity-type" />
                <div class="form-control">
                    <label class="label" for="draft-name">
                        <span class="label-text">Draft Name</span>
                    </label>
                    <input
                        type="text"
                        id="draft-name"
                        name="name"
                        class="input input-bordered w-full"
                        placeholder="e.g. Homepage redesign"
                        required
                        autocomplete="off"
                        maxlength="20"
                    />
                </div>
                <div class="modal-action mt-6">
                    <button type="button" class="btn btn-ghost" id="cancel-draft-btn">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Draft</button>
                </div>
            </form>
        </div>
        <form method="dialog" class="modal-backdrop">
            <button>close</button>
        </form>
    </dialog>

    <script>import '../../../scripts/select-all'</script>
    <script>
        const modal = document.getElementById('create-draft-modal') as HTMLDialogElement;
        const entityIdInput = document.getElementById('draft-entity-id') as HTMLInputElement;
        const entityTypeInput = document.getElementById('draft-entity-type') as HTMLInputElement;
        const nameInput = document.getElementById('draft-name') as HTMLInputElement;
        const cancelBtn = document.getElementById('cancel-draft-btn');

        document.querySelectorAll<HTMLButtonElement>('[data-create-draft]').forEach(btn => {
            btn.addEventListener('click', () => {
                entityIdInput.value = btn.dataset.entityId ?? '';
                entityTypeInput.value = btn.dataset.entityType ?? '';
                nameInput.value = '';
                modal.showModal();
            });
        });

        cancelBtn?.addEventListener('click', () => modal.close());
    </script>
</AdminLayout>
