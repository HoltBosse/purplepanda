---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import HistoryView from '../../../../components/HistoryView';
import type { DagNodeData } from '../../../../components/HistoryView';
import { getDb } from '../../../../db/db.js';
import { pages, dagNodes } from '../../../../db/schema.js';
import { eq, and, or, gt } from 'drizzle-orm';

const db = getDb();
const { id } = Astro.params;

if (!id) return Astro.redirect('/admin/pages');

const [page] = await db.select().from(pages).where(eq(pages.id, id)).limit(1);
if (!page) return Astro.redirect('/admin/pages');

const allNodes = await db
    .select()
    .from(dagNodes)
    .where(
        and(
            eq(dagNodes.entityId, id),
            eq(dagNodes.entityType, 'page'),
            or(
                eq(dagNodes.nodeType, 'publish'),
                and(eq(dagNodes.nodeType, 'draft'), gt(dagNodes.state, -1)),
            ),
        )
    );

const pageTitle = (page.content as any)?.root?.props?.title || 'Untitled';

const serializedNodes: DagNodeData[] = allNodes.map(n => ({
    id: n.id,
    nodeType: n.nodeType as 'publish' | 'draft',
    name: n.name,
    createdAt: n.createdAt.toISOString(),
    parentId: n.parentId,
    content: n.content as Record<string, unknown>,
    state: n.state,
}));
---

<AdminLayout>
    <div class="flex items-center gap-2 border-b border-base-300 pt-2 pb-4 text-sm">
        <a href="/admin/pages" class="text-base-content/50 hover:text-base-content transition-colors">Pages</a>
        <span class="text-base-content/30">/</span>
        <span class="text-base-content/50">History</span>
        <span class="text-base-content/30">/</span>
        <span class="font-semibold truncate max-w-64" title={pageTitle}>{pageTitle}</span>
    </div>

    <div class="mt-4">
        <HistoryView
            client:load
            entityType="page"
            entityId={id}
            currentContent={page.content as Record<string, unknown>}
            nodes={serializedNodes}
        />
    </div>
</AdminLayout>
