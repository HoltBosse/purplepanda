---
import '../../../../styles/global.css';
import externalPuckConfig from 'virtual:purplepanda/puck-config';
import type { Data } from '@puckeditor/core';
import { eq, sql } from 'drizzle-orm';
import PageRenderer from '../../../../components/PageRenderer.js';
import { getDb } from '../../../../db/db.js';
import { resolveFontSettings } from '../../../../db/fonts.js';
import { dagNodes, settings, templates } from '../../../../db/schema.js';
import { formatPageTitle, resolveSiteName } from '../../../../db/site.js';
import { extractFamilyFromLink } from '../../../../form/fields/font-utils.js';
import { resolveDataForSSR } from '../../../../puck/server-data-wrapper.js';

const db = getDb();
const { draftId } = Astro.params;

if (!draftId) return Astro.redirect('/admin/pages');

const [draft] = await db.select().from(dagNodes).where(eq(dagNodes.id, draftId)).limit(1);
if (!draft || (draft.nodeType !== 'draft' && draft.nodeType !== 'publish') || draft.entityType !== 'page' || draft.state === -1) {
    return Astro.redirect('/admin/pages');
}

const templateSetting = await db
    .select()
    .from(settings)
    .leftJoin(templates, sql`(${templates.id})::text = (${settings.value} #>> '{}')`)
    .where(eq(settings.key, 'default_template'))
    .limit(1)
    .then(rows => rows[0]);

const config = externalPuckConfig ?? {};

const [pageData, templateData, fontSettings, siteName] = await Promise.all([
    resolveDataForSSR(config, draft.content as Data),
    templateSetting?.templates?.content
        ? resolveDataForSSR(config, templateSetting.templates.content as Data)
        : Promise.resolve(undefined),
    resolveFontSettings(db),
    resolveSiteName(db),
]);

const title: string = formatPageTitle((pageData as any)?.root?.props?.title ?? '', siteName);
const headingFontFamily = extractFamilyFromLink(fontSettings.headingFontLink);
const bodyFontFamily = extractFamilyFromLink(fontSettings.bodyFontLink);
---

<!DOCTYPE html>
<html lang="en" data-theme="false">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    {fontSettings.bodyFontLink && <link rel="stylesheet" href={fontSettings.bodyFontLink} />}
    {fontSettings.headingFontLink && fontSettings.headingFontLink !== fontSettings.bodyFontLink && (
        <link rel="stylesheet" href={fontSettings.headingFontLink} />
    )}
    <style define:vars={{
        bodyFontFamily: bodyFontFamily ? `'${bodyFontFamily}', sans-serif` : 'inherit',
        headingFontFamily: headingFontFamily ? `'${headingFontFamily}', sans-serif` : 'inherit',
    }}>
        body { font-family: var(--bodyFontFamily); }
        :global(h1), :global(h2), :global(h3), :global(h4), :global(h5), :global(h6) { font-family: var(--headingFontFamily); }
    </style>
</head>
<body data-purplepanda-islands>
    <PageRenderer pageData={pageData} templateData={templateData} />
</body>
</html>
