---
import '../../../../styles/global.css';
import type { Data } from '@puckeditor/core';
import { eq } from 'drizzle-orm';
import PageRenderer from '../../../../components/PageRenderer.js';
import ThemeHead from '../../../../components/ThemeHead.astro';
import { getContentTypeById } from '../../../../db/content-types.js';
import { getDb } from '../../../../db/db.js';
import { dagNodes, pages } from '../../../../db/schema.js';
import { formatPageTitle, resolveSiteName } from '../../../../db/site.js';
import { resolveTemplateSetting } from '../../../../db/templates.js';
import { resolveDataForSSR } from '../../../../puck/server-data-wrapper.js';
import externalPuckConfig from '../../../../puck.config.js';
import { REPLACEMENT_DEFAULTS } from '../../../../theme/index.js';

// Dynamically imported (not a static top-level import) so it's only pulled into the SSR
// dependency graph on an actual page request — see the same comment in page.astro.
const { renderToStaticMarkup } = await import('react-dom/server');

const db = getDb();
const { draftId } = Astro.params;

if (!draftId) return Astro.redirect('/admin/content');

const [draft] = await db.select().from(dagNodes).where(eq(dagNodes.id, draftId)).limit(1);
if (!draft || (draft.nodeType !== 'draft' && draft.nodeType !== 'publish') || draft.entityType !== 'content' || draft.state === -1) {
    return Astro.redirect('/admin/content');
}

const [entity] = await db.select().from(pages).where(eq(pages.id, draft.entityId)).limit(1);
if (!entity?.contentType || !(await getContentTypeById(db, entity.contentType))) {
    return Astro.redirect('/admin/content');
}

const templateSetting = await resolveTemplateSetting(db, entity?.contentType ?? undefined);

const config = externalPuckConfig ?? {};

const [pageData, templateData, siteName] = await Promise.all([
    resolveDataForSSR(config, draft.content as Data),
    templateSetting?.templates?.content
        ? resolveDataForSSR(config, templateSetting.templates.content as Data)
        : Promise.resolve(undefined),
    resolveSiteName(db),
]);

const title: string = formatPageTitle((pageData as any)?.root?.props?.title ?? '', siteName);
---

<!DOCTYPE html>
<html lang="en" data-theme="false">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <ThemeHead />
</head>
<body data-scheme={REPLACEMENT_DEFAULTS.scheme}>
    <PageRenderer pageData={pageData} templateData={templateData} renderIsolatedIsland={renderToStaticMarkup} />
    <script>
        import "../../../../puck/hydrate-page-islands.js";
    </script>
</body>
</html>
