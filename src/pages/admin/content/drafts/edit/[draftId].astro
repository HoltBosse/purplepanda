---
import AdminBareLayout from '../../../../../layouts/AdminBareLayout.astro';
import ContentPuckEditor from '../../../../../components/ContentPuckEditor';
import { getDb } from '../../../../../db/db.js';
import { pages, dagNodes } from '../../../../../db/schema.js';
import { eq } from 'drizzle-orm';
import { resolveTemplateSetting } from '../../../../../db/templates.js';
import { resolveFontSettings } from '../../../../../db/fonts.js';
import type { Data } from '@puckeditor/core';

const db = getDb();
const { draftId } = Astro.params;

const [draft] = await db.select().from(dagNodes).where(eq(dagNodes.id, draftId!)).limit(1);
if (!draft || draft.nodeType !== 'draft' || draft.entityType !== 'content' || draft.state === -1) {
    return Astro.redirect('/admin/content');
}

const [entity] = await db.select().from(pages).where(eq(pages.id, draft.entityId)).limit(1);
if (!entity || !entity.contentType) {
    return Astro.redirect('/admin/content');
}

const saveUrl = `/admin/content/drafts/update/${draftId}`;
const draftPublishUrl = `/admin/content/drafts/publish/${draftId}`;

const [templateSetting, fontSettings] = await Promise.all([
    resolveTemplateSetting(db, entity.contentType),
    resolveFontSettings(db),
]);

const templateData = templateSetting?.templates?.content as Data | undefined;
---
<AdminBareLayout>
    <ContentPuckEditor
        client:only="react"
        contentTypeId={entity.contentType}
        saveUrl={saveUrl}
        draftPublishUrl={draftPublishUrl}
        initialData={draft.content as Data}
        isDraft
        {...(templateData ? { templateData } : {})}
        {...(fontSettings.headingFontLink ? { headingFontLink: fontSettings.headingFontLink } : {})}
        {...(fontSettings.bodyFontLink ? { bodyFontLink: fontSettings.bodyFontLink } : {})}
    />
</AdminBareLayout>
