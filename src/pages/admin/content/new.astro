---
import AdminBareLayout from '../../../layouts/AdminBareLayout.astro';
import ContentPuckEditor from '../../../components/ContentPuckEditor';
import { getDb } from '../../../db/db.js';
import { pages } from '../../../db/schema.js';
import { eq } from 'drizzle-orm';
import { resolveTemplateSetting } from '../../../db/templates.js';
import { resolvePrefabSetting } from '../../../db/prefabs.js';
import externalPuckConfig from "virtual:purplepanda/puck-config";
import type { Data } from '@puckeditor/core';

const { typeId, id } = Astro.params;

const contentTypes = (externalPuckConfig?.contentTypes) ?? [];
const contentType = contentTypes.find(ct => ct.id === typeId);

if (!typeId || !contentType) {
    return Astro.rewrite('/admin/__not-found');
}

const db = getDb();

let saveUrl = `/admin/content/${typeId}/update`;
if (id) {
    saveUrl += `/${id}`;
}

const [templateSetting, existingPage, prefabSetting] = await Promise.all([
    resolveTemplateSetting(db, typeId),
    id
        ? db.select().from(pages).where(eq(pages.id, id)).limit(1).then(rows => rows[0])
        : Promise.resolve(undefined),
    id ? Promise.resolve(undefined) : resolvePrefabSetting(db, typeId),
]);

if (id && !existingPage) {
    throw new Error('Content not found');
}

const templateData = templateSetting?.templates?.content as Data | undefined;
const prefabData = prefabSetting?.value as Data | undefined;

const editorProps = {
    ...(existingPage
        ? { initialData: existingPage.content as Data }
        : (prefabData ? { initialData: prefabData } : {})),
    ...(templateData ? { templateData } : {}),
};
---
<AdminBareLayout>
    <ContentPuckEditor
        client:only="react"
        contentTypeId={typeId}
        saveUrl={saveUrl}
        {...editorProps}
    />
</AdminBareLayout>
