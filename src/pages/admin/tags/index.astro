---
import { CircleCheck, CircleX, CornerDownRight } from '@lucide/astro';
import { and, desc, eq, type InferSelectModel, isNull, or, sql } from 'drizzle-orm';
import { alias } from 'drizzle-orm/pg-core';
import { z } from 'zod';
import Pagination from '../../../components/Pagination.astro';
import { getDb } from '../../../db/db.js';
import { tags } from '../../../db/schema.js';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { applySearchJoins, buildSearchWhere, type DrizzleSearchConfig } from '../../../search/drizzle.js';
import { parseSearchQuery } from '../../../search/parser.js';
import SearchBar from '../../../search/SearchBar';
import type { SearchFieldSpec } from '../../../search/types.js';

type Tag = InferSelectModel<typeof tags>;

const db = getDb();

// Self-join so a tag can be filtered by its parent's title, and so `parent:null` finds top-level
// tags (the join yields NULL both for a tag with no parent and one whose parent row is gone).
const parentTags = alias(tags, 'parent_tags');

// Client-safe field descriptions passed to <SearchBar>: drive its validation, github-style
// valid/invalid highlighting, and the qualifier/value autocomplete dropdown.
// "enabled"/"disabled" matches this page's Enable/Disable bulk actions.
const searchFields: SearchFieldSpec[] = [
    {
        name: 'state',
        type: 'enum',
        enumValues: ['enabled', 'disabled', 'deleted'],
        label: 'State',
        description: 'Tag state',
    },
    { name: 'title', type: 'text', label: 'Title', description: 'Tag title contains' },
    { name: 'parent', type: 'text', nullable: true, label: 'Parent', description: 'Parent tag (null = top level)' },
];

const searchConfig: DrizzleSearchConfig = {
    fields: [
        {
            name: 'state',
            type: 'enum',
            enumValues: ['enabled', 'disabled', 'deleted'],
            column: tags.state,
            valueMap: { enabled: 1, disabled: 0, deleted: -1 },
            // Hidden from the plain listing until searched for explicitly (`state:deleted`).
            defaultExclude: ['deleted'],
        },
        { name: 'title', type: 'text', column: tags.title, matchMode: 'contains' },
        { name: 'parent', type: 'text', nullable: true, column: parentTags.title, matchMode: 'contains' },
    ],
    fulltext: { columns: [tags.title] },
    joins: [{ table: parentTags, on: eq(tags.parentTag, parentTags.id), type: 'left' }],
};

const q = Astro.url.searchParams.get('q') ?? '';
const isSearching = q.trim().length > 0;
const searchWhere = buildSearchWhere(parseSearchQuery(q), searchConfig);

const itemsPerPage = 12;
const pageData = z.coerce.number().int().positive().default(1).safeParse(Astro.url.searchParams.get("page") ?? 1);
let page = 1;
if (pageData.success) {
    page = pageData.data;
}
const offset = (page - 1) * itemsPerPage;

// A tag sits at the root if it has no parent, or if its parent row no longer exists — matching how
// the tree below treats an unresolvable parent.
const isRootTag = or(
    isNull(tags.parentTag),
    sql`not exists (select 1 from ${tags} ancestor where ancestor.id = ${tags.parentTag})`,
);

let orderedTags: { tag: Tag; depth: number }[] = [];
let totalItems = 0;

if (isSearching) {
    // Filtering inevitably breaks the parent/child chain (a match's parent may not match), so
    // results are shown as a flat list rather than silently rendering orphans at the wrong depth.
    const [rows, total] = await Promise.all([
        applySearchJoins(db.selectDistinct({ ...getTagColumns() }).from(tags).$dynamic(), searchConfig.joins)
            .where(searchWhere)
            .orderBy(desc(tags.id))
            .limit(itemsPerPage)
            .offset(offset),
        applySearchJoins(
            db.select({ count: sql<number>`COUNT(DISTINCT ${tags.id})` }).from(tags).$dynamic(),
            searchConfig.joins,
        )
            .where(searchWhere)
            .then(result => result[0]?.count ?? 0),
    ]);
    orderedTags = rows.map(tag => ({ tag, depth: 1 }));
    totalItems = total;
} else {
    // Paginating raw rows would split a subtree across pages, leaving children stranded and drawn
    // as if they were top-level. Paginating by ROOT instead keeps every subtree whole, so a page
    // may render more rows than `itemsPerPage` — the page size counts roots, not tags.
    const [rootPage, totalRoots, everyTag] = await Promise.all([
        db.select().from(tags).where(and(searchWhere, isRootTag)).orderBy(desc(tags.id)).limit(itemsPerPage).offset(offset),
        db.select({ count: sql<number>`COUNT(*)` }).from(tags).where(and(searchWhere, isRootTag)).then(r => r[0]?.count ?? 0),
        db.select().from(tags).where(searchWhere).orderBy(desc(tags.id)),
    ]);

    const childrenByParent = new Map<string, Tag[]>();
    for (const tag of everyTag) {
        if (!tag.parentTag) continue;
        if (!childrenByParent.has(tag.parentTag)) childrenByParent.set(tag.parentTag, []);
        childrenByParent.get(tag.parentTag)!.push(tag);
    }

    // `visited` guards against a parent cycle, which the self-referencing FK doesn't prevent.
    function addChildren(parentId: string, depth: number, visited: Set<string>) {
        for (const child of childrenByParent.get(parentId) ?? []) {
            if (visited.has(child.id)) continue;
            orderedTags.push({ tag: child, depth });
            addChildren(child.id, depth + 1, new Set(visited).add(child.id));
        }
    }

    for (const root of rootPage) {
        orderedTags.push({ tag: root, depth: 1 });
        addChildren(root.id, 2, new Set([root.id]));
    }
    totalItems = totalRoots;
}

function getTagColumns() {
    return { id: tags.id, state: tags.state, title: tags.title, parentTag: tags.parentTag };
}

const totalPages = Math.ceil(totalItems / itemsPerPage);
---

<AdminLayout>
	<div class="flex flex-wrap items-center justify-between gap-3 align-middle border-b border-base-300 pt-2 sticky top-0 z-10 bg-base-200">
        <h1 class="text-2xl font-semibold">Tags</h1>
        <a href="/admin/tags/new" class="btn btn-primary">New</a>
    </div>
    <div class="pt-4 pb-6">
        <SearchBar client:load fields={searchFields} defaultValue={q} className="w-full" />
    </div>
    <form id="bulk-form" method="POST"></form>
    {orderedTags.length === 0 && (
        <div class="text-center text-base-content/60 py-8 bg-base-100 rounded-lg">
            {q ? 'No tags match your search.' : 'No tags yet.'}
        </div>
    )}
    {orderedTags.length > 0 && (
        <>
        <table class="hidden sm:table p-2 bg-base-100 rounded-lg">
        <thead>
            <tr class="hidden [table:has(.row-select:checked)_&]:table-row">
                <th class="w-px whitespace-nowrap">
                    <label>
                        <input type="checkbox" class="checkbox select-all" />
                    </label>
                </th>
                <th colspan="2">
                    <div class="flex items-center gap-2">
                        <button form="bulk-form" type="submit" formaction="/admin/tags/bulk/publish" class="btn btn-xs btn-outline btn-accent">Enable</button>
                        <button form="bulk-form" type="submit" formaction="/admin/tags/bulk/unpublish" class="btn btn-xs btn-outline btn-warning">Disable</button>
                        <button form="bulk-form" type="submit" formaction="/admin/tags/bulk/delete" class="btn btn-xs btn-error">Delete</button>
                    </div>
                </th>
            </tr>
            <tr class="[table:has(.row-select:checked)_&]:hidden">
                <th class="w-px whitespace-nowrap">
                    <label>
                        <input type="checkbox" class="checkbox select-all" />
                    </label>
                </th>
                <th class="w-px whitespace-nowrap">State</th>
                <th>Title</th>
            </tr>
        </thead>
        <tbody>
            {orderedTags.map(({ tag, depth }) => (
                <tr>
                    <td>
                        <label>
                            <input
                                form="bulk-form"
                                type="checkbox"
                                class="checkbox row-select"
                                name="selected[]"
                                value={tag.id}
                            />
                        </label>
                    </td>
                    <td class="w-px whitespace-nowrap">
                        <form action={`/admin/tags/toggle/${tag.id}`} method="POST">
                            <button class="btn btn-square" type="submit">
                                {tag.state === 1 ? <CircleCheck size={20} class="text-green-500" /> : <CircleX size={20} class="text-red-500" />}
                            </button>
                        </form>
                    </td>
                    <td>
                        <a href={`/admin/tags/edit/${tag.id}`}>
                            <div class="font-bold flex items-center gap-1">
                                {depth > 1 && <span class="whitespace-pre">{' '.repeat((depth - 2) * 2)}</span>}
                                {depth > 1 && <CornerDownRight size={14} class="text-base-content/50 shrink-0" />}
                                <span class="link-info link-hover">{tag.title}</span>
                            </div>
                        </a>
                    </td>
                </tr>
            ))}
        </tbody>
    </table>

    <div class="sm:hidden admin-cards flex flex-col gap-3">
        <div class="hidden items-center gap-2 bg-base-100 rounded-lg p-3 [.admin-cards:has(.row-select:checked)_&]:flex">
            <label>
                <input type="checkbox" class="checkbox select-all" />
            </label>
            <button form="bulk-form" type="submit" formaction="/admin/tags/bulk/publish" class="btn btn-xs btn-outline btn-accent">Enable</button>
            <button form="bulk-form" type="submit" formaction="/admin/tags/bulk/unpublish" class="btn btn-xs btn-outline btn-warning">Disable</button>
            <button form="bulk-form" type="submit" formaction="/admin/tags/bulk/delete" class="btn btn-xs btn-error">Delete</button>
        </div>
        <div class="flex items-center gap-2 bg-base-100 rounded-lg p-3 [.admin-cards:has(.row-select:checked)_&]:hidden">
            <label class="flex items-center gap-2">
                <input type="checkbox" class="checkbox select-all" />
                <span class="text-sm text-base-content/60">Select all</span>
            </label>
        </div>
        {orderedTags.map(({ tag, depth }) => (
            <div class="card bg-base-100 rounded-lg p-4">
                <div class="flex items-center justify-between gap-2 pb-3 mb-3 border-b border-base-300">
                    <label class="flex items-center gap-2">
                        <input
                            form="bulk-form"
                            type="checkbox"
                            class="checkbox row-select"
                            name="selected[]"
                            value={tag.id}
                        />
                        <span class="text-sm text-base-content/60">Select</span>
                    </label>
                    <form action={`/admin/tags/toggle/${tag.id}`} method="POST">
                        <button class="btn btn-square btn-sm" type="submit">
                            {tag.state === 1 ? <CircleCheck size={18} class="text-green-500" /> : <CircleX size={18} class="text-red-500" />}
                        </button>
                    </form>
                </div>
                <dl class="flex flex-col gap-2">
                    <div class="flex justify-between gap-4">
                        <dt class="text-sm text-base-content/60">Title</dt>
                        <dd class="text-right">
                            <a href={`/admin/tags/edit/${tag.id}`}>
                                <div class="font-bold flex items-center justify-end gap-1">
                                    {depth > 1 && <CornerDownRight size={14} class="text-base-content/50 shrink-0" />}
                                    <span class="link-info link-hover">{tag.title}</span>
                                </div>
                            </a>
                        </dd>
                    </div>
                </dl>
            </div>
        ))}
    </div>
        </>
    )}
    {totalPages > 1 &&
        <div class="pt-6 pb-6 flex items-center justify-center">
            <Pagination currentPage={page} totalPages={totalPages} basePath="/admin/tags/" params={{ q }} />
        </div>
    }
    <script>import '../../../scripts/select-all'</script>
</AdminLayout>
