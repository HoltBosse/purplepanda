---
import externalPuckConfig from 'virtual:purplepanda/puck-config';
import { CircleCheck, CircleX, GitBranch } from '@lucide/astro';
import { desc, eq, inArray, sql } from 'drizzle-orm';
import { z } from 'zod';
import Pagination from '../../../components/Pagination.astro';
import { getDb } from '../../../db/db.js';
import { settings, templates, userActions, users } from '../../../db/schema.js';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { applySearchJoins, buildSearchWhere, type DrizzleSearchConfig } from '../../../search/drizzle.js';
import { parseSearchQuery } from '../../../search/parser.js';
import SearchBar from '../../../search/SearchBar';
import type { SearchFieldSpec } from '../../../search/types.js';

const db = getDb();

const contentTypes = externalPuckConfig?.contentTypes ?? [];

// A template's title isn't a column — Puck stores it in the content document, which is why the
// table below reads `content.root.props.title`. The search builder accepts an arbitrary SQL
// expression in place of a column, so the same path can be filtered on directly in Postgres.
const titleExpr = sql`${templates.content} -> 'root' -> 'props' ->> 'title'`;

// Client-safe field descriptions passed to <SearchBar>: drive its validation, github-style
// valid/invalid highlighting, and the qualifier/value autocomplete dropdown.
const searchFields: SearchFieldSpec[] = [
    {
        name: 'state',
        type: 'enum',
        enumValues: ['published', 'unpublished', 'deleted'],
        label: 'State',
        description: 'Publish state',
    },
    { name: 'title', type: 'text', label: 'Title', description: 'Title contains' },
    { name: 'author', type: 'text', nullable: true, label: 'Author', description: 'Creator email (null = unattributed)' },
    { name: 'created', type: 'date', label: 'Created', description: 'Date created (YYYY-MM-DD)' },
];

// Server-side counterpart. `templates` has no author or created-at column, so both ride on the
// `template:create` row that `templates/update.ts` logs to `userActions`
// (`{ type: "template:create", data: { id: <templateId> } }`) whenever a template is created.
const searchConfig: DrizzleSearchConfig = {
    fields: [
        {
            name: 'state',
            type: 'enum',
            enumValues: ['published', 'unpublished', 'deleted'],
            column: templates.state,
            // "deleted" has no matching rows today (toggle only flips between 1 and 0) — -1 is
            // reserved so a future soft-delete can slot in without a grammar change.
            valueMap: { published: 1, unpublished: 0, deleted: -1 },
            // Hidden from the plain listing until searched for explicitly (`state:deleted`).
            defaultExclude: ['deleted'],
        },
        { name: 'title', type: 'text', column: titleExpr, matchMode: 'contains' },
        { name: 'author', type: 'text', nullable: true, column: users.email, matchMode: 'exact' },
        { name: 'created', type: 'date', column: userActions.date },
    ],
    // A bare term searches the title — the one piece of template text this listing shows.
    fulltext: { columns: [titleExpr] },
    joins: [
        {
            table: userActions,
            on: sql`${userActions.type} = 'template:create' and ${userActions.data} ->> 'id' = ${templates.id}::text`,
            type: 'left',
        },
        { table: users, on: eq(userActions.userId, users.id), type: 'left' },
    ],
};

const q = Astro.url.searchParams.get('q') ?? '';
const searchWhere = buildSearchWhere(parseSearchQuery(q), searchConfig);

const itemsPerPage = 12;
const pageData = z.coerce.number().int().positive().default(1).safeParse(Astro.url.searchParams.get("page") ?? 1);
let page = 1;
if (pageData.success) {
    page = pageData.data;
}
const offset = (page - 1) * itemsPerPage;

// DISTINCT (here and in the count below) because the userActions/users joins are one-to-many: a
// template with more than one `template:create` action would otherwise be listed — and counted —
// once per matching action row.
const [allTemplates, totalTemplates] = await Promise.all([
    applySearchJoins(
        db.selectDistinct({ id: templates.id, state: templates.state, content: templates.content }).from(templates).$dynamic(),
        searchConfig.joins,
    )
        .where(searchWhere)
        .orderBy(desc(templates.id))
        .limit(itemsPerPage)
        .offset(offset),
    applySearchJoins(
        db.select({ count: sql<number>`COUNT(DISTINCT ${templates.id})` }).from(templates).$dynamic(),
        searchConfig.joins,
    )
        .where(searchWhere)
        .then(result => result[0]?.count ?? 0),
]);

const totalPages = Math.ceil(totalTemplates / itemsPerPage);

// Surface which templates are currently wired up as a default (site-wide "Pages" default, or a
// content type's default) so the listing can badge-link straight back to the setting that
// controls it. Keyed off the same `settings` rows the settings page itself writes/reads.
const defaultSettingKeys = ['default_template', ...contentTypes.map(ct => `content_default_template_${ct.id}`)];
const defaultSettings = await db.select().from(settings).where(inArray(settings.key, defaultSettingKeys));
const defaultTemplateInfo = new Map<string, { isPagesDefault: boolean; contentTypeMatches: { title: string; href: string }[] }>();
for (const templateId of allTemplates.map(t => t.id)) {
    const isPagesDefault = defaultSettings.some(s => s.key === 'default_template' && s.value === templateId);
    const contentTypeMatches = contentTypes
        .filter(ct => defaultSettings.some(s => s.key === `content_default_template_${ct.id}` && s.value === templateId))
        .map(ct => ({ title: ct.title, href: `/admin/settings#content-template-group-${ct.id}` }));
    if (isPagesDefault || contentTypeMatches.length > 0) {
        defaultTemplateInfo.set(templateId, { isPagesDefault, contentTypeMatches });
    }
}
---

<AdminLayout>
	<div class="flex flex-wrap items-center justify-between gap-3 align-middle border-b border-base-300 pt-2 sticky top-0 z-10 bg-base-200">
        <h1 class="text-2xl font-semibold">Templates</h1>
        <a href="/admin/templates/new" class="btn btn-primary">New</a>
    </div>
    <div class="pt-4 pb-6">
        <SearchBar client:load fields={searchFields} defaultValue={q} className="w-full" />
    </div>
    <form id="bulk-form" method="POST"></form>
    {allTemplates.length === 0 && (
        <div class="text-center text-base-content/60 py-8 bg-base-100 rounded-lg">
            {q ? 'No templates match your search.' : 'No templates yet.'}
        </div>
    )}
    {allTemplates.length > 0 && (
        <>
    <table class="hidden sm:table p-2 bg-base-100 rounded-lg">
        <thead>
            <tr class="hidden [table:has(.row-select:checked)_&]:table-row">
                <th class="w-px whitespace-nowrap">
                    <label>
                        <input type="checkbox" class="checkbox select-all" />
                    </label>
                </th>
                <th colspan="3">
                    <div class="flex items-center gap-2">
                        <button form="bulk-form" type="submit" formaction="/admin/templates/bulk/publish" class="btn btn-xs btn-outline btn-accent">Publish</button>
                        <button form="bulk-form" type="submit" formaction="/admin/templates/bulk/unpublish" class="btn btn-xs btn-outline btn-warning">Unpublish</button>
                        <button form="bulk-form" type="submit" formaction="/admin/templates/bulk/delete" class="btn btn-xs btn-error">Delete</button>
                    </div>
                </th>
            </tr>
            <tr class="[table:has(.row-select:checked)_&]:hidden">
                <th class="w-px whitespace-nowrap">
                    <label>
                        <input type="checkbox" class="checkbox select-all" />
                    </label>
                </th>
                <th class="w-px whitespace-nowrap">State</th>
                <th>Template</th>
                <th class="w-px whitespace-nowrap"></th>
            </tr>
        </thead>
        <tbody>
            {allTemplates.map(template => {
                const info = defaultTemplateInfo.get(template.id);
                return (
                <tr>
                    <td>
                        <label>
                            <input
                                form="bulk-form"
                                type="checkbox"
                                class="checkbox row-select"
                                name="selected[]"
                                value={template.id}
                            />
                        </label>
                    </td>
                    <td class="w-px whitespace-nowrap">
                        <form action={`/admin/templates/toggle/${template.id}`} method="POST">
                            <button class="btn btn-square" type="submit">
                                {template.state === 1 ? <CircleCheck size={20} class="text-green-500" /> : <CircleX size={20} class="text-red-500" />}
                            </button>
                        </form>
                    </td>
                    <td>
                        <div class="flex items-center gap-2 flex-wrap">
                            <a href={`/admin/templates/edit/${template.id}`}>
                                <span class="font-bold link link-info link-hover">{(template.content as any)?.root?.props?.title || 'Untitled'}</span>
                            </a>
                            {info?.isPagesDefault && (
                                <span class="text-xs text-base-content/40 whitespace-nowrap">(<a href="/admin/settings#dt-group" class="hover:text-base-content/70">default</a>)</span>
                            )}
                            {info && info.contentTypeMatches.length > 0 && (
                                <span class="text-xs text-base-content/40 whitespace-nowrap">
                                    (default: {info.contentTypeMatches.map((ct, i) => (
                                        <>{i > 0 && ', '}<a href={ct.href} class="hover:text-base-content/70">{ct.title}</a></>
                                    ))})
                                </span>
                            )}
                        </div>
                    </td>
                    <td class="w-px whitespace-nowrap">
                        <a href={`/admin/templates/history/${template.id}`} class="btn btn-ghost btn-sm btn-square" title="History">
                            <GitBranch size={16} />
                        </a>
                    </td>
                </tr>
                );
            })}
        </tbody>
    </table>

    <div class="sm:hidden admin-cards flex flex-col gap-3">
        <div class="hidden items-center gap-2 bg-base-100 rounded-lg p-3 [.admin-cards:has(.row-select:checked)_&]:flex">
            <label>
                <input type="checkbox" class="checkbox select-all" />
            </label>
            <button form="bulk-form" type="submit" formaction="/admin/templates/bulk/publish" class="btn btn-xs btn-outline btn-accent">Publish</button>
            <button form="bulk-form" type="submit" formaction="/admin/templates/bulk/unpublish" class="btn btn-xs btn-outline btn-warning">Unpublish</button>
            <button form="bulk-form" type="submit" formaction="/admin/templates/bulk/delete" class="btn btn-xs btn-error">Delete</button>
        </div>
        <div class="flex items-center gap-2 bg-base-100 rounded-lg p-3 [.admin-cards:has(.row-select:checked)_&]:hidden">
            <label class="flex items-center gap-2">
                <input type="checkbox" class="checkbox select-all" />
                <span class="text-sm text-base-content/60">Select all</span>
            </label>
        </div>
        {allTemplates.map(template => {
            const info = defaultTemplateInfo.get(template.id);
            return (
            <div class="card bg-base-100 rounded-lg p-4">
                <div class="flex items-center justify-between gap-2 pb-3 mb-3 border-b border-base-300">
                    <label class="flex items-center gap-2">
                        <input
                            form="bulk-form"
                            type="checkbox"
                            class="checkbox row-select"
                            name="selected[]"
                            value={template.id}
                        />
                        <span class="text-sm text-base-content/60">Select</span>
                    </label>
                    <div class="flex items-center gap-1">
                        <form action={`/admin/templates/toggle/${template.id}`} method="POST">
                            <button class="btn btn-square btn-sm" type="submit">
                                {template.state === 1 ? <CircleCheck size={18} class="text-green-500" /> : <CircleX size={18} class="text-red-500" />}
                            </button>
                        </form>
                        <a href={`/admin/templates/history/${template.id}`} class="btn btn-ghost btn-sm btn-square" title="History">
                            <GitBranch size={16} />
                        </a>
                    </div>
                </div>
                <dl class="flex flex-col gap-2">
                    <div class="flex justify-between gap-4">
                        <dt class="text-sm text-base-content/60">Template</dt>
                        <dd class="text-right">
                            <a href={`/admin/templates/edit/${template.id}`}>
                                <span class="font-bold link link-info link-hover">{(template.content as any)?.root?.props?.title || 'Untitled'}</span>
                            </a>
                            {info && (
                                <div class="text-xs text-base-content/40">
                                    {info.isPagesDefault && (
                                        <span class="whitespace-nowrap">(<a href="/admin/settings#dt-group" class="hover:text-base-content/70">default</a>)</span>
                                    )}
                                    {info.contentTypeMatches.length > 0 && (
                                        <span class="whitespace-nowrap">
                                            (default: {info.contentTypeMatches.map((ct, i) => (
                                                <>{i > 0 && ', '}<a href={ct.href} class="hover:text-base-content/70">{ct.title}</a></>
                                            ))})
                                        </span>
                                    )}
                                </div>
                            )}
                        </dd>
                    </div>
                </dl>
            </div>
            );
        })}
    </div>
        </>
    )}
    {totalTemplates - allTemplates.length > 0 &&
        <div class="pt-6 pb-6 flex items-center justify-center">
            <Pagination currentPage={page} totalPages={totalPages} basePath="/admin/templates/" params={{ q }} />
        </div>
    }
    <script>import '../../../scripts/select-all'</script>
</AdminLayout>
