---
import type { Config, Data } from '@puckeditor/core';
import externalPuckConfig from 'virtual:purplepanda/puck-config';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getDb } from '../../../../db/db.js';
import { formSubmissions, forms } from '../../../../db/schema.js';
import { eq } from 'drizzle-orm';
import { filterConfigByLocation } from '../../../../puck/index.js';
import { resolveDataForSSR } from '../../../../puck/server-data-wrapper.js';
import LocalDateTime from '../../../../components/LocalDateTime.astro';

const db = getDb();
const { id } = Astro.params;

if (!id) return Astro.redirect('/admin/forms/submissions');

const [submission] = await db
    .select({
        id: formSubmissions.id,
        createdAt: formSubmissions.createdAt,
        data: formSubmissions.data,
        formContent: forms.content,
    })
    .from(formSubmissions)
    .innerJoin(forms, eq(formSubmissions.formId, forms.id))
    .where(eq(formSubmissions.id, id))
    .limit(1);

if (!submission) return Astro.redirect('/admin/forms/submissions');

const formName = (submission.formContent as any)?.root?.props?.name || 'Untitled';

function formatBytes(bytes: number): string {
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}

function isFileValue(value: unknown): value is { name: string; size: number; type: string } {
    return !!value && typeof value === 'object' && 'name' in value && 'size' in value && 'type' in value;
}

// Run each field's own `data` resolver (e.g. Select's content/users option lookup) before reading
// props, the same way FormEmbed.server.ts does for rendering a live form — so a field whose
// `options` prop is just a stale manual-mode leftover (see Select.tsx's `data` resolver comment)
// gets its real choices merged in first. This keeps the walk below generic: it never needs to know
// which field types have dynamic sources.
const formConfig = filterConfigByLocation((externalPuckConfig as Config) ?? ({} as Config), 'form');
const resolvedFormContent = await resolveDataForSSR(formConfig, submission.formContent as Data);

// Walk the form's Puck content tree to find each field's display label and its choice options
// (Select, RadioGroup) or checkbox label, so the submissions table can show the label the form
// editor set rather than the raw `field-<id>` key, and so submitted codes (e.g. "option-1") can
// be resolved back to the human-readable label the visitor actually saw. Also collects which
// field keys opt out of display entirely via `submissionDisplay: false` on their component config
// (e.g. Turnstile, whose stored value is a verification token rather than a meaningful answer).
type FieldOption = { label: string; value: string };
const labelByFieldName: Record<string, string> = {};
const optionsByFieldName: Record<string, FieldOption[]> = {};
const checkboxLabelByFieldName: Record<string, string> = {};
const hiddenFieldNames = new Set<string>();
// Which component owns each field (and its stored props), so a component that implements
// `renderSubmissionValue` (see puck/index.ts) can be looked up and run per field below — kept
// generic so any future field type can opt into custom rendering the same way, not just Image.
const typeByFieldName: Record<string, string> = {};
const propsByFieldName: Record<string, Record<string, unknown>> = {};

function collectFieldMeta(node: unknown): void {
    if (Array.isArray(node)) {
        node.forEach(collectFieldMeta);
        return;
    }
    if (!node || typeof node !== 'object') return;

    const type = (node as any).type;
    const props = (node as any).props;
    if (props && typeof props.id === 'string') {
        const fieldName = `field-${props.id}`;
        if (typeof props.label === 'string' && props.label) {
            labelByFieldName[fieldName] = props.label;
        }
        if (Array.isArray(props.options)) {
            optionsByFieldName[fieldName] = props.options;
        } else if (typeof props.checkboxLabel === 'string') {
            checkboxLabelByFieldName[fieldName] = props.checkboxLabel;
        }
        if (typeof type === 'string') {
            typeByFieldName[fieldName] = type;
            propsByFieldName[fieldName] = props;
            if (formConfig.components?.[type]?.submissionDisplay === false) {
                hiddenFieldNames.add(fieldName);
            }
        }
    }

    Object.values(node).forEach(collectFieldMeta);
}

collectFieldMeta(resolvedFormContent);

function resolveFieldLabel(key: string): string {
    return labelByFieldName[key] ?? key;
}

function resolveDisplayValue(key: string, raw: unknown): string {
    if (checkboxLabelByFieldName[key] !== undefined) return checkboxLabelByFieldName[key];
    const options = optionsByFieldName[key];
    if (options) return options.find((opt) => opt.value === raw)?.label ?? String(raw ?? '');
    return String(raw ?? '');
}

function formatValue(key: string, value: unknown): string {
    if (Array.isArray(value)) return value.map((v) => formatValue(key, v)).join(', ');
    if (isFileValue(value)) return `${value.name} (${value.type || 'unknown type'}, ${formatBytes(value.size)})`;
    return resolveDisplayValue(key, value);
}

const fields = Object.entries(submission.data as Record<string, unknown>).filter(([key]) => !hiddenFieldNames.has(key));

// Pre-render any field whose component opts into custom submission rendering (e.g. Image.tsx
// showing its stored media reference as a thumbnail instead of a printed object) — computed
// ahead of time since Astro template expressions below can't themselves be async.
const renderedByFieldName: Record<string, string> = {};
for (const [key, value] of fields) {
    const type = typeByFieldName[key];
    const renderSubmissionValue = type ? (formConfig.components as any)?.[type]?.renderSubmissionValue : undefined;
    if (typeof renderSubmissionValue === 'function') {
        renderedByFieldName[key] = await renderSubmissionValue(value, propsByFieldName[key]);
    }
}
---

<AdminLayout>
    <div class="flex items-center gap-2 border-b border-base-300 pt-2 pb-4 text-sm">
        <a href="/admin/forms/submissions" class="text-base-content/50 hover:text-base-content transition-colors">Submissions</a>
        <span class="text-base-content/30">/</span>
        <span class="font-semibold truncate max-w-64" title={formName}>{formName}</span>
    </div>

    <div class="mt-4 flex items-center justify-between align-middle pb-4">
        <h1 class="text-2xl font-semibold">{formName}</h1>
        <span class="text-base-content/60 text-sm">Submitted <LocalDateTime date={submission.createdAt} /></span>
    </div>

    <table class="table p-2 bg-base-100 rounded-lg">
        <thead>
            <tr>
                <th>Field</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody>
            {fields.map(([key, value]) => (
                <tr>
                    <td class="w-px whitespace-nowrap font-medium">{resolveFieldLabel(key)}</td>
                    <td class="whitespace-pre-wrap break-words">
                        {renderedByFieldName[key] !== undefined
                            ? <Fragment set:html={renderedByFieldName[key]} />
                            : formatValue(key, value)}
                    </td>
                </tr>
            ))}
        </tbody>
    </table>
</AdminLayout>
