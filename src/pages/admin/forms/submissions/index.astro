---
import { and, desc, gt, sql } from 'drizzle-orm';
import { z } from 'zod';
import LocalDateTime from '../../../../components/LocalDateTime.astro';
import Pagination from '../../../../components/Pagination.astro';
import { getDb } from '../../../../db/db.js';
import { formSubmissions, forms } from '../../../../db/schema.js';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { applySearchJoins, buildSearchWhere } from '../../../../search/drizzle.js';
import { parseSearchQuery } from '../../../../search/parser.js';
import SearchBar from '../../../../search/SearchBar';
import { searchConfig, searchFields } from './search-config.js';

const db = getDb();

const q = Astro.url.searchParams.get('q') ?? '';
const searchWhere = buildSearchWhere(parseSearchQuery(q), searchConfig);

const itemsPerPage = 12;
const pageData = z.coerce.number().int().positive().default(1).safeParse(Astro.url.searchParams.get("page") ?? 1);
let page = 1;
if (pageData.success) {
    page = pageData.data;
}
const offset = (page - 1) * itemsPerPage;

// state > -1 hides soft-deleted submissions, on top of whatever the search matched.
const listFilter = and(gt(formSubmissions.state, -1), searchWhere);

const [submissions, totalSubmissions] = await Promise.all([
    applySearchJoins(
        db
            .select({
                id: formSubmissions.id,
                createdAt: formSubmissions.createdAt,
                formContent: forms.content,
            })
            .from(formSubmissions)
            .$dynamic(),
        searchConfig.joins,
    )
        .where(listFilter)
        .orderBy(desc(formSubmissions.createdAt))
        .limit(itemsPerPage)
        .offset(offset),
    applySearchJoins(
        db.select({ count: sql<number>`COUNT(*)` }).from(formSubmissions).$dynamic(),
        searchConfig.joins,
    )
        .where(listFilter)
        .then(result => result[0]?.count ?? 0),
]);

const totalPages = Math.ceil(totalSubmissions / itemsPerPage);

const exportHref = `/admin/forms/submissions/export${q ? `?q=${encodeURIComponent(q)}` : ''}`;
---

<AdminLayout>
    <div class="flex flex-wrap items-center justify-between gap-3 align-middle border-b border-base-300 pt-2 sticky top-0 z-10 bg-base-200">
        <h1 class="text-2xl font-semibold">Form Submissions</h1>
        <a href={exportHref} class="btn btn-outline btn-primary">Export All</a>
    </div>
    <div class="pt-4 pb-6">
        <SearchBar client:load fields={searchFields} defaultValue={q} className="w-full" />
    </div>
    <table class="table p-2 bg-base-100 rounded-lg">
        <thead>
            <tr>
                <th>Form</th>
                <th class="w-px whitespace-nowrap">Submitted</th>
            </tr>
        </thead>
        <tbody>
            {submissions.length === 0 && (
                <tr>
                    <td colspan="2" class="text-center text-base-content/60 py-8">
                        {q ? 'No submissions match your search.' : 'No submissions yet.'}
                    </td>
                </tr>
            )}
            {submissions.map(submission => (
                <tr>
                    <td>
                        <a href={`/admin/forms/submissions/${submission.id}`} class="font-bold link link-info link-hover">
                            {(submission.formContent as any)?.root?.props?.name || 'Untitled'}
                        </a>
                    </td>
                    <td class="w-px whitespace-nowrap"><LocalDateTime date={submission.createdAt} /></td>
                </tr>
            ))}
        </tbody>
    </table>
    {totalSubmissions - submissions.length > 0 &&
        <div class="pt-6 pb-6 flex items-center justify-center">
            <Pagination currentPage={page} totalPages={totalPages} basePath="/admin/forms/submissions/" params={{ q }} />
        </div>
    }
</AdminLayout>
