---
import { CircleCheck, CircleX, GitBranch } from '@lucide/astro';
import { desc, eq, sql } from 'drizzle-orm';
import { z } from 'zod';
import Pagination from '../../../components/Pagination.astro';
import { getDb } from '../../../db/db.js';
import { forms, userActions, users } from '../../../db/schema.js';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { findFormEmbedUsage } from '../../../puck/form/embed-usage.js';
import { applySearchJoins, buildSearchWhere, type DrizzleSearchConfig } from '../../../search/drizzle.js';
import { parseSearchQuery } from '../../../search/parser.js';
import SearchBar from '../../../search/SearchBar';
import type { SearchFieldSpec } from '../../../search/types.js';

const db = getDb();

// A form's name isn't a column — Puck stores it in the content document, which is why the table
// below reads `content.root.props.name`. The search builder accepts an arbitrary SQL expression in
// place of a column, so the same path can be filtered on directly in Postgres.
const nameExpr = sql`${forms.content} -> 'root' -> 'props' ->> 'name'`;

// Client-safe field descriptions passed to <SearchBar>: drive its validation, github-style
// valid/invalid highlighting, and the qualifier/value autocomplete dropdown.
const searchFields: SearchFieldSpec[] = [
    {
        name: 'state',
        type: 'enum',
        enumValues: ['published', 'unpublished', 'deleted'],
        label: 'State',
        description: 'Publish state',
    },
    { name: 'name', type: 'text', label: 'Name', description: 'Form name contains' },
    { name: 'author', type: 'text', nullable: true, label: 'Author', description: 'Creator email (null = unattributed)' },
    { name: 'created', type: 'date', label: 'Created', description: 'Date created (YYYY-MM-DD)' },
];

// Server-side counterpart. `forms` has no author or created-at column, so both ride on the
// `form:create` row that `forms/update.ts` logs to `userActions`
// (`{ type: "form:create", data: { id: <formId> } }`) whenever a form is created.
const searchConfig: DrizzleSearchConfig = {
    fields: [
        {
            name: 'state',
            type: 'enum',
            enumValues: ['published', 'unpublished', 'deleted'],
            column: forms.state,
            // "deleted" has no matching rows today (toggle only flips between 1 and 0) — -1 is
            // reserved so a future soft-delete can slot in without a grammar change.
            valueMap: { published: 1, unpublished: 0, deleted: -1 },
            // Hidden from the plain listing until searched for explicitly (`state:deleted`).
            defaultExclude: ['deleted'],
        },
        { name: 'name', type: 'text', column: nameExpr, matchMode: 'contains' },
        { name: 'author', type: 'text', nullable: true, column: users.email, matchMode: 'exact' },
        { name: 'created', type: 'date', column: userActions.date },
    ],
    // A bare term searches the form name — the one piece of form text this listing shows.
    fulltext: { columns: [nameExpr] },
    joins: [
        {
            table: userActions,
            on: sql`${userActions.type} = 'form:create' and ${userActions.data} ->> 'id' = ${forms.id}::text`,
            type: 'left',
        },
        { table: users, on: eq(userActions.userId, users.id), type: 'left' },
    ],
};

const q = Astro.url.searchParams.get('q') ?? '';
const searchWhere = buildSearchWhere(parseSearchQuery(q), searchConfig);

const itemsPerPage = 12;
const pageData = z.coerce.number().int().positive().default(1).safeParse(Astro.url.searchParams.get("page") ?? 1);
let page = 1;
if (pageData.success) {
    page = pageData.data;
}
const offset = (page - 1) * itemsPerPage;

// DISTINCT (here and in the count below) because the userActions/users joins are one-to-many: a
// form with more than one `form:create` action would otherwise be listed — and counted — once per
// matching action row.
const [allForms, totalForms] = await Promise.all([
    applySearchJoins(
        db.selectDistinct({ id: forms.id, state: forms.state, content: forms.content }).from(forms).$dynamic(),
        searchConfig.joins,
    )
        .where(searchWhere)
        .orderBy(desc(forms.id))
        .limit(itemsPerPage)
        .offset(offset),
    applySearchJoins(
        db.select({ count: sql<number>`COUNT(DISTINCT ${forms.id})` }).from(forms).$dynamic(),
        searchConfig.joins,
    )
        .where(searchWhere)
        .then(result => result[0]?.count ?? 0),
]);

const totalPages = Math.ceil(totalForms / itemsPerPage);

// Surface where each form is actually embedded so the listing can badge-link straight to the
// page/template that uses it — see puck/form/embed-usage.ts for how.
const embedRows = await findFormEmbedUsage(db, allForms.map(f => f.id));

const formUsage = new Map<string, { title: string; href: string }[]>();
const seen = new Set<string>();
for (const row of embedRows) {
    const dedupeKey = `${row.formId}:${row.hrefBase}/${row.entityId}`;
    if (seen.has(dedupeKey)) continue;
    seen.add(dedupeKey);
    const list = formUsage.get(row.formId) ?? [];
    list.push({ title: row.title, href: `${row.hrefBase}/${row.entityId}` });
    formUsage.set(row.formId, list);
}
---

<AdminLayout>
    <div class="flex flex-wrap items-center justify-between gap-3 align-middle border-b border-base-300 pt-2 sticky top-0 z-10 bg-base-200">
        <h1 class="text-2xl font-semibold">Forms</h1>
        <a href="/admin/forms/new" class="btn btn-primary">New</a>
    </div>
    <div class="pt-4 pb-6">
        <SearchBar client:load fields={searchFields} defaultValue={q} className="w-full" />
    </div>
    <form id="bulk-form" method="POST"></form>
    {allForms.length === 0 && (
        <div class="text-center text-base-content/60 py-8 bg-base-100 rounded-lg">
            {q ? 'No forms match your search.' : 'No forms yet.'}
        </div>
    )}
    {allForms.length > 0 && (
        <>
    <table class="hidden sm:table p-2 bg-base-100 rounded-lg">
        <thead>
            <tr class="hidden [table:has(.row-select:checked)_&]:table-row">
                <th class="w-px whitespace-nowrap">
                    <label>
                        <input type="checkbox" class="checkbox select-all" />
                    </label>
                </th>
                <th colspan="3">
                    <div class="flex items-center gap-2">
                        <button form="bulk-form" type="submit" formaction="/admin/forms/bulk/publish" class="btn btn-xs btn-outline btn-accent">Publish</button>
                        <button form="bulk-form" type="submit" formaction="/admin/forms/bulk/unpublish" class="btn btn-xs btn-outline btn-warning">Unpublish</button>
                        <button form="bulk-form" type="submit" formaction="/admin/forms/bulk/delete" class="btn btn-xs btn-error">Delete</button>
                    </div>
                </th>
            </tr>
            <tr class="[table:has(.row-select:checked)_&]:hidden">
                <th class="w-px whitespace-nowrap">
                    <label>
                        <input type="checkbox" class="checkbox select-all" />
                    </label>
                </th>
                <th class="w-px whitespace-nowrap">State</th>
                <th>Form</th>
                <th class="w-px whitespace-nowrap"></th>
            </tr>
        </thead>
        <tbody>
            {allForms.map(form => {
                const usage = formUsage.get(form.id);
                return (
                <tr>
                    <td>
                        <label>
                            <input
                                form="bulk-form"
                                type="checkbox"
                                class="checkbox row-select"
                                name="selected[]"
                                value={form.id}
                            />
                        </label>
                    </td>
                    <td class="w-px whitespace-nowrap">
                        <form action={`/admin/forms/toggle/${form.id}`} method="POST">
                            <button class="btn btn-square" type="submit">
                                {form.state === 1 ? <CircleCheck size={20} class="text-green-500" /> : <CircleX size={20} class="text-red-500" />}
                            </button>
                        </form>
                    </td>
                    <td>
                        <div class="flex items-center gap-2 flex-wrap">
                            <a href={`/admin/forms/edit/${form.id}`}>
                                <span class="font-bold link link-info link-hover">{(form.content as any)?.root?.props?.name || 'Untitled'}</span>
                            </a>
                            {usage && usage.length > 0 && (
                                <span class="text-xs text-base-content/40 whitespace-nowrap">
                                    (on: {usage.map((u, i) => (
                                        <>{i > 0 && ', '}<a href={u.href} class="hover:text-base-content/70">{u.title}</a></>
                                    ))})
                                </span>
                            )}
                        </div>
                    </td>
                    <td class="w-px whitespace-nowrap">
                        <a href={`/admin/forms/history/${form.id}`} class="btn btn-ghost btn-sm btn-square" title="History">
                            <GitBranch size={16} />
                        </a>
                    </td>
                </tr>
                );
            })}
        </tbody>
    </table>

    <div class="sm:hidden admin-cards flex flex-col gap-3">
        <div class="hidden items-center gap-2 bg-base-100 rounded-lg p-3 [.admin-cards:has(.row-select:checked)_&]:flex">
            <label>
                <input type="checkbox" class="checkbox select-all" />
            </label>
            <button form="bulk-form" type="submit" formaction="/admin/forms/bulk/publish" class="btn btn-xs btn-outline btn-accent">Publish</button>
            <button form="bulk-form" type="submit" formaction="/admin/forms/bulk/unpublish" class="btn btn-xs btn-outline btn-warning">Unpublish</button>
            <button form="bulk-form" type="submit" formaction="/admin/forms/bulk/delete" class="btn btn-xs btn-error">Delete</button>
        </div>
        <div class="flex items-center gap-2 bg-base-100 rounded-lg p-3 [.admin-cards:has(.row-select:checked)_&]:hidden">
            <label class="flex items-center gap-2">
                <input type="checkbox" class="checkbox select-all" />
                <span class="text-sm text-base-content/60">Select all</span>
            </label>
        </div>
        {allForms.map(form => {
            const usage = formUsage.get(form.id);
            return (
            <div class="card bg-base-100 rounded-lg p-4">
                <div class="flex items-center justify-between gap-2 pb-3 mb-3 border-b border-base-300">
                    <label class="flex items-center gap-2">
                        <input
                            form="bulk-form"
                            type="checkbox"
                            class="checkbox row-select"
                            name="selected[]"
                            value={form.id}
                        />
                        <span class="text-sm text-base-content/60">Select</span>
                    </label>
                    <div class="flex items-center gap-1">
                        <form action={`/admin/forms/toggle/${form.id}`} method="POST">
                            <button class="btn btn-square btn-sm" type="submit">
                                {form.state === 1 ? <CircleCheck size={18} class="text-green-500" /> : <CircleX size={18} class="text-red-500" />}
                            </button>
                        </form>
                        <a href={`/admin/forms/history/${form.id}`} class="btn btn-ghost btn-sm btn-square" title="History">
                            <GitBranch size={16} />
                        </a>
                    </div>
                </div>
                <dl class="flex flex-col gap-2">
                    <div class="flex justify-between gap-4">
                        <dt class="text-sm text-base-content/60">Form</dt>
                        <dd class="text-right">
                            <a href={`/admin/forms/edit/${form.id}`}>
                                <span class="font-bold link link-info link-hover">{(form.content as any)?.root?.props?.name || 'Untitled'}</span>
                            </a>
                            {usage && usage.length > 0 && (
                                <div class="text-xs text-base-content/40">
                                    <span class="whitespace-nowrap">
                                        (on: {usage.map((u, i) => (
                                            <>{i > 0 && ', '}<a href={u.href} class="hover:text-base-content/70">{u.title}</a></>
                                        ))})
                                    </span>
                                </div>
                            )}
                        </dd>
                    </div>
                </dl>
            </div>
            );
        })}
    </div>
        </>
    )}
    {totalForms - allForms.length > 0 &&
        <div class="pt-6 pb-6 flex items-center justify-center">
            <Pagination currentPage={page} totalPages={totalPages} basePath="/admin/forms/" params={{ q }} />
        </div>
    }
    <script>import '../../../scripts/select-all'</script>
</AdminLayout>
