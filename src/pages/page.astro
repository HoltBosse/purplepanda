---
import '../styles/global.css';
import { getDb } from '../db/db.js';
import { pages, settings, templates, redirects } from '../db/schema.js';
import { and, eq, isNull, sql } from 'drizzle-orm';
import type { Data } from '@puckeditor/core';
import externalPuckConfig from 'virtual:purplepanda/puck-config';
import { has404Page } from 'virtual:purplepanda/has-404';
import { resolveDataForSSR } from '../puck/server-data-wrapper.js';
import PageRenderer from '../components/PageRenderer.js';

const db = getDb();
const requestPath = Astro.params.path ?? '';
const config = externalPuckConfig ?? {};

function normalizeBaseUrl(baseUrl: string): string {
    return baseUrl.replace(/^\/+|\/+$/g, '');
}

function matchContentTypeRoute(path: string) {
    for (const contentType of config.contentTypes ?? []) {
        if (!contentType.baseUrl) continue;
        const base = normalizeBaseUrl(contentType.baseUrl);
        if (!base || !path.startsWith(`${base}/`)) continue;
        const alias = path.slice(base.length + 1);
        if (alias && !alias.includes('/')) {
            return { contentType, alias };
        }
    }
    return null;
}

async function resolvePlainPage(path: string) {
    const allPages = await db.select().from(pages).where(and(eq(pages.state, 1), isNull(pages.contentType)));
    const pageById = new Map(allPages.map(p => [p.id, p]));

    function getPagePath(page: typeof allPages[0], visited = new Set<string>()): string {
        if (visited.has(page.id)) return '';
        const content = page.content as any;
        const alias: string = content?.root?.props?.alias ?? '';
        const parentId: string = content?.root?.props?.parentPage ?? '';
        if (parentId && pageById.has(parentId)) {
            const parentPath = getPagePath(pageById.get(parentId)!, new Set([...visited, page.id]));
            return parentPath ? `${parentPath}/${alias}` : alias;
        }
        return alias;
    }

    const pathToPage = new Map(allPages.map(p => [getPagePath(p), p]));
    return pathToPage.get(path);
}

const contentTypeRoute = matchContentTypeRoute(requestPath);

const [matchedPage, templateSetting] = await Promise.all([
    contentTypeRoute
        ? db
            .select()
            .from(pages)
            .where(and(
                eq(pages.state, 1),
                eq(pages.contentType, contentTypeRoute.contentType.id),
                sql`(${pages.content}->'root'->'props'->>'alias') = ${contentTypeRoute.alias}`
            ))
            .limit(1)
            .then(rows => rows[0])
        : resolvePlainPage(requestPath),
    db
        .select()
        .from(settings)
        .leftJoin(templates, sql`(${templates.id})::text = (${settings.value} #>> '{}')`)
        .where(eq(settings.key, 'default_template'))
        .limit(1)
        .then(rows => rows[0]),
]);

if (!matchedPage) {
    const fromPath = '/' + requestPath;
    const [redirect] = await db
        .select()
        .from(redirects)
        .where(eq(redirects.from, fromPath))
        .limit(1);

    if (redirect && redirect.state === 1) {
        return Astro.redirect(redirect.to, 301);
    }

    if (has404Page) {
        return Astro.rewrite('/404');
    }
    return new Response('Not Found', { status: 404 });
}

const [pageData, templateData] = await Promise.all([
    resolveDataForSSR(config, matchedPage.content as Data, Astro.locals),
    templateSetting?.templates?.content
        ? resolveDataForSSR(config, templateSetting.templates.content as Data, Astro.locals)
        : Promise.resolve(undefined),
]);

const title: string = (pageData as any)?.root?.props?.title ?? '';
---

<!DOCTYPE html>
<html lang="en" data-theme="false">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
</head>
<body data-purplepanda-islands>
    <PageRenderer pageData={pageData} templateData={templateData} />
</body>
</html>
