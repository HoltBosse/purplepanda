---
import '../styles/global.css';
import * as z from 'zod';
import { parseLoginTarget, withLoginTarget } from '../auth/login-target.js';
import { forgotPasswordErrorSchema } from '../auth/password-reset.js';

// Asks for an account's email and sends it a reset link (see forgot-password-action.ts). Root site
// only, like the sign-in it sits beside; `site`/`host` are carried through so the account ends up
// back where its sign-in started.
if (!Astro.locals.tenant.isRoot) {
  return Astro.rewrite('/404');
}

const target = parseLoginTarget(Astro.url.searchParams);
const error = forgotPasswordErrorSchema.safeParse(Astro.url.searchParams.get("error")).data;
const sent = z.literal("1").safeParse(Astro.url.searchParams.get("sent")).success;
const loginHref = withLoginTarget('/login', target);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot password</title>
    <link rel="icon" type="image/svg+xml" href="/admin/assets/favicon.svg" />
    <link rel="icon" href="/admin/assets/favicon.ico" />
  </head>
  <body class="min-h-screen flex items-center justify-center bg-base-200">
    <div class="card bg-base-100 shadow-md w-full" style="max-width: 24rem;">
      <div class="card-body">
        <h1 class="card-title text-2xl mb-2">Forgot password</h1>
        {sent ? (
          <p class="text-sm">
            If an account exists for that email, we've sent it a link to reset the password. The link
            expires in an hour.
          </p>
        ) : (
          <>
            <p class="text-sm opacity-70 mb-2">Enter your account's email and we'll send you a link to reset your password.</p>
            {error === "invalid" && (
              <p class="text-error text-sm mb-2">Please enter a valid email address.</p>
            )}
            {error === "throttled" && (
              <p class="text-error text-sm mb-2">Too many reset requests. Please wait a while and try again.</p>
            )}
            <form method="POST" action="/forgot-password-action" class="flex flex-col gap-4">
              {target.site && <input type="hidden" name="site" value={target.site} />}
              {target.host && <input type="hidden" name="host" value={target.host} />}
              <label class="form-control w-full">
                <div class="label">
                  <span class="label-text font-medium">Email</span>
                </div>
                <input
                  type="email"
                  name="email"
                  required
                  maxlength="255"
                  autocomplete="email"
                  class="input input-bordered w-full"
                />
              </label>
              <button type="submit" class="btn btn-primary w-full">Send reset link</button>
            </form>
          </>
        )}
        <a href={loginHref} class="link link-hover text-sm mt-2">Back to sign in</a>
      </div>
    </div>
  </body>
</html>
