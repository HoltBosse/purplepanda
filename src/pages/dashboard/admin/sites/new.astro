---
import { asc, desc, eq } from 'drizzle-orm';
import { dashboardAccess } from '../../../../auth/dashboard.js';
import { getDb } from '../../../../db/db.js';
import { tenantDomains, tenants } from '../../../../db/schema.js';
import { createFormFlashSession } from '../../../../form/session.js';
import PortalLayout from '../../../../layouts/PortalLayout.astro';
import { optInComponentNames } from '../../../../puck/site-components.js';
import externalPuckConfig from '../../../../puck.config.js';

const access = await dashboardAccess(Astro, { superAdmin: true });
if (access.response) {
    return access.response;
}
const { user } = access;

const db = getDb();
const { id } = Astro.params;

let name = '';
let enabledComponents: string[] = [];
let domains: { domain: string; isRoot: boolean; isPrimary: boolean }[] = [];
if (id) {
    const [tenant] = await db.select().from(tenants).where(eq(tenants.id, id)).limit(1);
    if (!tenant) {
        return Astro.rewrite('/404');
    }
    name = tenant.name;
    enabledComponents = tenant.enabledComponents;
    domains = await db
        .select({ domain: tenantDomains.domain, isRoot: tenantDomains.isRoot, isPrimary: tenantDomains.isPrimary })
        .from(tenantDomains)
        .where(eq(tenantDomains.tenantId, id))
        .orderBy(desc(tenantDomains.isRoot), asc(tenantDomains.domain));
}
const isRootTenant = domains.some((domain) => domain.isRoot);

// Whatever was posted, when the update handler bounced it back with an error.
const formFlash = createFormFlashSession(Astro.session);
const flash = await formFlash.get('tenant') ?? {};
await formFlash.delete('tenant');

const nameValue = flash.name ?? name;
const domainsValue = flash.domains ?? domains.map((domain) => domain.domain).join('\n');
const rootValue = flash.root ?? domains.find((domain) => domain.isRoot)?.domain ?? '';
const rootOptions = domains.map((domain) => domain.domain);
const primaryValue = flash.primary ?? domains.find((domain) => domain.isPrimary)?.domain ?? '';

// The components this build marks `optIn` (see src/puck/site-components.ts), each ticked when this
// site has it enabled. Enabled names this build doesn't have are kept by the update handler, and
// only counted here.
const components = (externalPuckConfig?.components ?? {}) as Record<string, { label?: string }>;
const optInComponents = optInComponentNames(externalPuckConfig ?? {})
    .map((componentName) => ({ name: componentName, label: components[componentName]?.label ?? componentName }))
    .sort((a, b) => a.label.localeCompare(b.label));
const checkedComponents = flash.components !== undefined
    ? flash.components.split('\n')
    : enabledComponents;
const unknownComponentCount = enabledComponents.filter((componentName) => !(componentName in components)).length;

const action = id ? `/dashboard/admin/sites/update/${id}` : '/dashboard/admin/sites/update';
const inputClassList = "w-full rounded-md border border-gray-300 px-3 py-2 focus:border-blue-500 focus:outline-none focus:ring focus:ring-blue-200";
---

<PortalLayout user={user} title={id ? 'Edit site' : 'New site'}>
    <form method="POST" action={action} class="space-y-6">
        {!id && (
            <div role="alert" class="alert alert-warning mt-2">
                <span>
                    <strong>Work in progress:</strong> creating sites here is not complete yet. Consult the admin
                    before adding a new site.
                </span>
            </div>
        )}

        <div class="flex items-center justify-between align-middle pt-2">
            <h1 class="text-2xl font-semibold">{id ? 'Edit Site' : 'New Site'}</h1>
            <button class="btn btn-primary">Save</button>
        </div>

        <div class="p-6 bg-base-100 rounded-lg space-y-6">
            <h2 class="text-lg font-medium">Site</h2>
            <label class="block">
                <span class="block mb-1 font-medium">Name</span>
                <input class={inputClassList} type="text" name="name" value={nameValue} required maxlength="255" />
            </label>
            <label class="block">
                <span class="block mb-1 font-medium">Domains</span>
                <textarea class={`${inputClassList} font-mono`} name="domains" rows="5" required placeholder={'example.com\nwww.example.com'}>{domainsValue}</textarea>
                <span class="block mt-1 text-sm opacity-70">
                    One hostname per line, without scheme, port or path — e.g. <code>example.com</code>,
                    <code>www.example.com</code> or <code>blog.example.com</code>. Point each one's DNS at this server.
                </span>
            </label>
            {!id && (
                <p class="text-sm opacity-70">
                    A new site starts empty, with an "Administrator" role. Sign in to its admin on one of its
                    domains with your super admin account to add its users and content.
                </p>
            )}
        </div>

        <div class="p-6 bg-base-100 rounded-lg space-y-4">
            <h2 class="text-lg font-medium">Components</h2>
            <p class="text-sm opacity-70">
                Every site can use the standard components. These ones are built for particular sites and only
                appear in this site's editors once enabled here. Turning one off takes it out of the editors and
                stops content that uses it from being saved until it's removed; published pages that use it keep
                rendering.
            </p>
            {optInComponents.length > 0 ? (
                <div class="grid gap-2 sm:grid-cols-2">
                    {optInComponents.map((component) => (
                        <label class="flex items-center gap-2">
                            <input type="checkbox" class="checkbox checkbox-sm" name="components" value={component.name} checked={checkedComponents.includes(component.name)} />
                            <span>{component.label}</span>
                            {component.label !== component.name && <code class="text-xs opacity-60">{component.name}</code>}
                        </label>
                    ))}
                </div>
            ) : (
                <p class="text-sm opacity-70">This install has no site-specific components.</p>
            )}
            {unknownComponentCount > 0 && (
                <p class="text-sm opacity-70">
                    {unknownComponentCount === 1 ? '1 more component is' : `${unknownComponentCount} more components are`}
                    {' '}enabled for this site but not part of this build. Saving leaves {unknownComponentCount === 1 ? 'it' : 'them'} enabled.
                </p>
            )}
        </div>

        {id && (
            <div class="p-6 bg-base-100 rounded-lg space-y-4">
                <h2 class="text-lg font-medium">Primary domain</h2>
                <p class="text-sm opacity-70">
                    With a primary domain set, this site's other domains permanently redirect to it, keeping the
                    path — e.g. <code>www.example.com/about</code> → <code>example.com/about</code>, or the other way
                    round. With none, every domain serves the site as-is.
                </p>
                <select class={`${inputClassList} bg-base-100 text-base-content`} name="primary">
                    <option class="bg-base-100 text-base-content" value="" selected={primaryValue === ''}>None — serve on every domain</option>
                    {rootOptions.map((domain) => (
                        <option class="bg-base-100 text-base-content" value={domain} selected={primaryValue === domain}>{domain}</option>
                    ))}
                </select>
            </div>
        )}

        {id && (
            <div class="p-6 bg-base-100 rounded-lg space-y-4">
                <h2 class="text-lg font-medium">Root domain</h2>
                <p class="text-sm opacity-70">
                    Exactly one domain across all sites is the root domain. Its site is where super admins manage
                    every other site from.
                    {!isRootTenant && ' Choosing one of this site’s domains moves the root here.'}
                </p>
                <select class={`${inputClassList} bg-base-100 text-base-content`} name="root">
                    {!isRootTenant && <option class="bg-base-100 text-base-content" value="" selected={rootValue === ''}>Not the root site</option>}
                    {rootOptions.map((domain) => (
                        <option class="bg-base-100 text-base-content" value={domain} selected={rootValue === domain}>{domain}</option>
                    ))}
                </select>
                {isRootTenant && (
                    <p class="text-sm opacity-70">To make a different site the root, edit that site instead.</p>
                )}
            </div>
        )}
    </form>
</PortalLayout>
